---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import BrowserMockup from './BrowserMockup.astro';
import PhoneMockup from './PhoneMockup.astro';
import ArtefactButtons from './ArtefactButtons.astro';
import { cases, type CaseMeta } from '../data/cases';
import { SITE } from '../data/site';

import coverDocket from '../assets/home/cover-docket.png';
import coverBluff from '../assets/home/cover-bluff.png';
import coverFlowlift from '../assets/home/cover-flowlift.png';
import coverPaymentx from '../assets/home/cover-paymentx.png';

// The shared dossier close: ending collage · recap chips · artefact
// button(s) · next-case card · circle CTA. Same structure on all four
// cases (the one vivid gradient moment per page lives in the sign-off cell).
interface Props {
  slug: CaseMeta['slug'];
  browserScreen: ImageMetadata;
  browserAlt: string;
  phoneScreen: ImageMetadata;
  phoneAlt: string;
  cell1: ImageMetadata;
  cell1Alt: string;
  cell2: ImageMetadata;
  cell2Alt: string;
  signoffCaps: string;
  chips: string[];
  /** Per-page next-case line (each Figma frame words it differently). */
  nextClaim?: string;
}

const {
  slug,
  browserScreen,
  browserAlt,
  phoneScreen,
  phoneAlt,
  cell1,
  cell1Alt,
  cell2,
  cell2Alt,
  signoffCaps,
  chips,
  nextClaim,
} = Astro.props;

const covers = {
  docket: coverDocket,
  bluff: coverBluff,
  flowlift: coverFlowlift,
  paymentx: coverPaymentx,
} as const;

const nextClaims: Record<CaseMeta['slug'], string> = {
  docket: 'Docket. AI can draft the decision. It can’t be accountable for it.',
  bluff: 'BLUFF. Fifteen months on a real casino’s money flows.',
  flowlift: 'FlowLift. Sixty screens, four platforms, seven days.',
  paymentx: 'PaymentX. A two-sided payments marketplace, from zero.',
};

const c = cases[slug];
const next = cases[c.next];
---

<section class="close cv-auto">
  <div class="collage container">
    <div class="collage-browser">
      <BrowserMockup screen={browserScreen} alt={browserAlt} />
    </div>
    <div class="collage-phone-cell">
      <PhoneMockup screen={phoneScreen} alt={phoneAlt} width="300px" class="collage-phone" />
    </div>
    <div class="collage-cell exhibit">
      <Picture
        src={cell1}
        widths={[384, 768]}
        sizes="(max-width: 900px) 100vw, 384px"
        formats={['avif', 'webp']}
        alt={cell1Alt}
        loading="lazy"
      />
    </div>
    <div class="collage-cell exhibit">
      <Picture
        src={cell2}
        widths={[384, 768]}
        sizes="(max-width: 900px) 100vw, 384px"
        formats={['avif', 'webp']}
        alt={cell2Alt}
        loading="lazy"
      />
    </div>
    <div class="collage-signoff">
      <p class="signoff-name">{c.name}</p>
      <p class="signoff-caps">{signoffCaps}</p>
    </div>
  </div>

  <div class="recap" role="list" aria-label="Case recap">
    {chips.map((chip) => <span class="recap-chip tnum" role="listitem">{chip}</span>)}
  </div>

  <div class="close-artefacts">
    <ArtefactButtons slug={slug} />
  </div>

  <a class="next-case" href={`/project/${c.next}`} data-event="case_next_click" data-case={slug}>
    <div class="next-thumb exhibit" style={`view-transition-name: cover-${c.next}`}>
      <Picture
        src={covers[c.next]}
        widths={[280, 560]}
        sizes="280px"
        formats={['avif', 'webp']}
        alt={`${next.name} cover`}
        loading="lazy"
      />
    </div>
    <div class="next-txt">
      <p class="next-label">NEXT CASE</p>
      <p class="next-claim">{nextClaim ?? nextClaims[c.next]}</p>
    </div>
    <Icon name="arrow-right" size={22} class="next-arrow" />
  </a>

  <div class="circle-wrap">
    <a
      href={`mailto:${SITE.email}`}
      class="circle-cta"
      data-event="outbound_click"
      data-channel="email"
      data-cta="true"
    >
      Email me
      <Icon name="arrow-up-right" size={16} />
    </a>
  </div>
</section>

<style>
  .close {
    padding-top: 48px;
    padding-bottom: 120px;
  }

  /* --- ending collage --- */
  .collage {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .collage-browser {
    grid-column: 1 / 3;
  }
  .collage-phone-cell {
    position: relative;
    background: var(--accent-tint);
    border-radius: var(--r-cell);
    overflow: hidden;
    min-height: 400px;
  }
  .collage-phone-cell :global(.collage-phone) {
    position: absolute;
    left: 50%;
    top: 15%;
    transform: translateX(-50%) rotate(8deg);
  }
  .collage-cell {
    border-radius: var(--r-cell);
    aspect-ratio: 384 / 276;
  }
  .collage-cell :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .collage-signoff {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    aspect-ratio: 384 / 276;
    border-radius: var(--r-cell);
    background: linear-gradient(135deg, var(--case-grad-a), var(--case-grad-b));
  }
  .signoff-name {
    font-size: 2.625rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: #fff;
  }
  .signoff-caps {
    font-size: var(--fs-caps-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
    line-height: var(--lh-caps);
    font-feature-settings: 'case' 1;
    color: rgba(255, 255, 255, 0.8);
  }

  /* --- recap chips --- */
  .recap {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 48px;
    padding-inline: var(--page-gutter);
  }
  .recap-chip {
    display: inline-flex;
    align-items: center;
    padding: 9px 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-pill);
    font-size: var(--fs-caps-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
    line-height: var(--lh-caps);
    font-feature-settings: 'case' 1;
    color: var(--ink-secondary);
  }

  .close-artefacts {
    display: flex;
    justify-content: center;
    margin-top: 32px;
  }

  /* --- next case --- */
  .next-case {
    display: flex;
    align-items: center;
    gap: 32px;
    max-width: 830px;
    margin: 48px auto 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    padding: 28px 32px;
    transition: border-color 0.15s ease;
  }
  .next-case:hover {
    border-color: var(--accent);
  }
  .next-thumb {
    flex-shrink: 0;
    width: 280px;
    border-radius: 12px;
    aspect-ratio: 280 / 158;
  }
  .next-thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .next-label {
    font-size: var(--fs-caps-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
    line-height: var(--lh-caps);
    font-feature-settings: 'case' 1;
    color: var(--ink-secondary);
  }
  .next-claim {
    margin-top: 10px;
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.35;
    color: var(--ink);
  }
  .next-case :global(.next-arrow) {
    flex-shrink: 0;
    margin-left: auto;
    color: var(--accent);
  }

  /* --- circle CTA (centred on mobile, always) --- */
  .circle-wrap {
    display: flex;
    justify-content: center;
    margin-top: 64px;
  }
  .circle-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-size: 1.1875rem;
    font-weight: 600;
    transition: background-color 0.15s ease, transform 0.2s ease;
  }
  .circle-cta:hover {
    background: var(--accent-bright);
    transform: scale(1.03);
  }

  @media (max-width: 900px) {
    .close {
      padding-bottom: 80px;
    }
    .collage {
      grid-template-columns: 1fr;
    }
    .collage-browser {
      grid-column: auto;
    }
    .collage-phone-cell {
      min-height: 360px;
    }
    .next-case {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      margin-inline: var(--page-gutter);
    }
    .next-thumb {
      width: 100%;
    }
    .next-case :global(.next-arrow) {
      margin-left: 0;
    }
    .circle-cta {
      width: 172px;
      height: 172px;
      font-size: 1.0625rem;
    }
  }
</style>
