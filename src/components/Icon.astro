---
// Phosphor icons (regular weight), inlined at build time. fill="currentColor"
// so icons take the surrounding text colour. The drawn decision-marks and the
// circled-g ring are NOT icons and never come from this set.
const icons = import.meta.glob<string>('../assets/icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 16, class: className } = Astro.props;
const raw = icons[`../assets/icons/${name}.svg`];
if (!raw) throw new Error(`Icon not found: ${name}`);
const attrs = [
  `width="${size}"`,
  `height="${size}"`,
  'aria-hidden="true"',
  className ? `class="${className}"` : '',
]
  .filter(Boolean)
  .join(' ');
const svg = raw.replace('<svg ', `<svg ${attrs} `);
---

<Fragment set:html={svg} />
