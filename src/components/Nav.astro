---
import Icon from './Icon.astro';
import { SITE } from '../data/site';

// The logo is ALWAYS cobalt (inline SVG, hard-coded), even on themed
// dossiers. The nav CTA takes var(--accent), so it follows the case hue.
// On home only, the ring draws itself once (~600ms) — the one licensed
// signature motion; reduced-motion shows it static.
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/index';
---

<header class="nav container">
  <a href="/" class="nav-logo" aria-label="gmats: home">
    <svg
      width="44"
      height="40"
      viewBox="0 0 44 40"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path
        d="M21.07 34.4C19.31 34.4 17.87 34.26 16.75 33.98C15.65 33.72 14.84 33.33 14.32 32.81C13.82 32.29 13.57 31.65 13.57 30.89C13.57 29.99 13.93 29.26 14.65 28.7C15.37 28.12 16.44 27.77 17.86 27.65V27.14C16.76 27.14 15.92 27.02 15.34 26.78C14.76 26.52 14.47 26.09 14.47 25.49C14.47 24.93 14.75 24.42 15.31 23.96C15.89 23.5 16.84 23.16 18.16 22.94V22.4C16.96 22.28 16 21.86 15.28 21.14C14.58 20.42 14.23 19.48 14.23 18.32C14.23 17.32 14.51 16.42 15.07 15.62C15.63 14.82 16.46 14.18 17.56 13.7C18.66 13.22 20.03 12.98 21.67 12.98H29.83V16.64L24.73 15.98V16.61C26.09 16.79 27.05 17.1 27.61 17.54C28.19 17.98 28.48 18.58 28.48 19.34C28.48 20.12 28.21 20.82 27.67 21.44C27.15 22.06 26.39 22.54 25.39 22.88C24.41 23.22 23.23 23.39 21.85 23.39C21.57 23.39 21.26 23.38 20.92 23.36C20.6 23.34 20.1 23.29 19.42 23.21C19.1 23.45 18.85 23.66 18.67 23.84C18.49 24.02 18.4 24.19 18.4 24.35C18.4 24.47 18.44 24.57 18.52 24.65C18.62 24.73 18.76 24.79 18.94 24.83C19.12 24.85 19.32 24.86 19.54 24.86H24.37C24.77 24.86 25.29 24.89 25.93 24.95C26.59 24.99 27.24 25.14 27.88 25.4C28.52 25.66 29.06 26.08 29.5 26.66C29.96 27.24 30.19 28.07 30.19 29.15C30.19 30.33 29.86 31.31 29.2 32.09C28.54 32.87 27.54 33.45 26.2 33.83C24.86 34.21 23.15 34.4 21.07 34.4ZM21.58 30.47C22.78 30.47 23.7 30.41 24.34 30.29C24.98 30.19 25.42 30.02 25.66 29.78C25.9 29.54 26.02 29.24 26.02 28.88C26.02 28.54 25.94 28.27 25.78 28.07C25.64 27.87 25.46 27.73 25.24 27.65C25.02 27.57 24.79 27.52 24.55 27.5C24.33 27.48 24.14 27.47 23.98 27.47H20.08C19.36 27.53 18.83 27.72 18.49 28.04C18.17 28.34 18.01 28.71 18.01 29.15C18.01 29.51 18.13 29.78 18.37 29.96C18.63 30.16 19.02 30.29 19.54 30.35C20.06 30.43 20.74 30.47 21.58 30.47ZM21.52 20.93C22.34 20.93 22.95 20.71 23.35 20.27C23.77 19.83 23.98 19.26 23.98 18.56C23.98 17.8 23.77 17.19 23.35 16.73C22.93 16.25 22.33 16.01 21.55 16.01C20.75 16.01 20.13 16.25 19.69 16.73C19.25 17.19 19.03 17.8 19.03 18.56C19.03 19.02 19.12 19.43 19.3 19.79C19.5 20.15 19.78 20.43 20.14 20.63C20.52 20.83 20.98 20.93 21.52 20.93Z"
        fill="#1A1B1E"></path>
      <path
        class:list={['logo-ring', { 'logo-ring-draw': isHome }]}
        d="M11 8.09501C0 12.095 -3 24.095 11 29.095C28 35.095 38 30.095 39 20.095C40 10.095 25 3.09501 14 4.09501C7 5.09501 2 8.09501 1 11.095"
        stroke="#2E5CE6"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        pathLength="1"></path>
    </svg>
  </a>

  <nav class="nav-right" aria-label="Primary">
    <a href="/project" class="nav-link">work</a>
    <a href="/about" class="nav-link">about</a>
    <a href="/contact" class="nav-link">contact</a>
    <span class="nav-chip caps-sm" aria-label="Available">
      <span class="nav-dot" aria-hidden="true"></span>
      AVAILABLE
    </span>
    <a
      href={SITE.calendly}
      target="_blank"
      rel="noopener"
      class="nav-cta"
      data-event="conversation_click"
      data-channel="call"
    >
      Book a call
      <Icon name="arrow-up-right" size={14} />
    </a>
  </nav>

  <details class="nav-mobile">
    <summary class="caps-sm">
      <span class="nav-dot" aria-hidden="true"></span>
      MENU
    </summary>
    <div class="nav-mobile-panel">
      <a href="/project">work</a>
      <a href="/about">about</a>
      <a href="/contact">contact</a>
      <a
        href={SITE.calendly}
        target="_blank"
        rel="noopener"
        class="nav-mobile-cta"
        data-event="conversation_click"
        data-channel="call">Book a call <Icon name="arrow-up-right" size={14} /></a>
    </div>
  </details>
</header>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 28px;
    position: relative;
  }

  .nav-logo svg {
    display: block;
  }

  /* The one licensed signature: the ring draws itself once, ~600ms. */
  @media (prefers-reduced-motion: no-preference) {
    .logo-ring-draw {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: ring-draw 0.6s ease-out 0.15s forwards;
    }
    @keyframes ring-draw {
      to {
        stroke-dashoffset: 0;
      }
    }
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 36px;
  }

  .nav-link {
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--ink);
  }
  .nav-link:hover {
    color: var(--accent);
  }

  .nav-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
    line-height: var(--lh-caps);
    font-feature-settings: 'case' 1;
    color: var(--ink-secondary);
  }

  .nav-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #15803d; /* static — never pulses */
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--accent);
  }
  .nav-cta:hover {
    color: var(--accent-bright);
  }

  /* --- mobile: logo + AVAILABLE dot + MENU (text, no burger glyph) --- */
  .nav-mobile {
    display: none;
    position: relative;
  }

  .nav-mobile summary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    list-style: none;
    cursor: pointer;
    font-size: var(--fs-caps-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
    line-height: var(--lh-caps);
    font-feature-settings: 'case' 1;
    color: var(--ink);
    padding: 8px 0;
  }
  .nav-mobile summary::-webkit-details-marker {
    display: none;
  }

  .nav-mobile-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    display: flex;
    flex-direction: column;
    min-width: 180px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-cell-m);
    padding: 8px;
    z-index: 20;
    box-shadow: var(--shadow-exhibit);
  }
  .nav-mobile-panel a {
    font-size: var(--fs-support);
    font-weight: 500;
    padding: 10px 12px;
    border-radius: 10px;
  }
  .nav-mobile-panel a:hover {
    background: var(--sunken);
  }
  .nav-mobile-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .nav {
      padding-block: 20px;
    }
    .nav-right {
      display: none;
    }
    .nav-mobile {
      display: block;
    }
  }
</style>
