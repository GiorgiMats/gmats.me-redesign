---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

// Before/after comparison slider (his exhibit interaction). The two captures
// are registration-aligned exports of the same staged browser, layered and
// clipped at --ba. A full-size transparent range input drives the divider,
// so drag, click and keyboard all come native. With JS off the split holds
// at the authored start position, which is the design's static state.
interface Props {
  before: ImageMetadata;
  beforeAlt: string;
  after: ImageMetadata;
  afterAlt: string;
  /** CSS aspect-ratio of the exhibit, e.g. "4 / 3". */
  aspect?: string;
  /** Divider start position, percent of width. */
  start?: number;
  widths?: number[];
  sizes?: string;
}

const {
  before,
  beforeAlt,
  after,
  afterAlt,
  aspect = '4 / 3',
  start = 30,
  widths = [640, 1200, 2400],
  sizes = '(max-width: 900px) 100vw, 1200px',
} = Astro.props;
---

<div class="ba" data-ba style={`--ba: ${start}%; aspect-ratio: ${aspect};`}>
  <Picture
    src={after}
    widths={widths}
    sizes={sizes}
    formats={['avif', 'webp']}
    alt={afterAlt}
    loading="eager"
    fetchpriority="high"
    class="ba-img ba-img-after"
  />
  <div class="ba-before" aria-hidden="true">
    <Picture
      src={before}
      widths={widths}
      sizes={sizes}
      formats={['avif', 'webp']}
      alt={beforeAlt}
      loading="eager"
      class="ba-img"
    />
  </div>
  <span class="ba-chip caps-xs ba-chip-before" aria-hidden="true">BEFORE</span>
  <span class="ba-chip caps-xs ba-chip-after" aria-hidden="true">AFTER</span>
  <div class="ba-divider" aria-hidden="true">
    <span class="ba-handle">
      <Icon name="caret-left" size={14} />
      <Icon name="caret-right" size={14} />
    </span>
  </div>
  <input
    type="range"
    class="ba-range"
    min="0"
    max="100"
    step="0.1"
    value={start}
    aria-label={`Compare before and after: ${afterAlt}`}
  />
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((root) => {
    const range = root.querySelector<HTMLInputElement>('.ba-range');
    if (!range) return;
    range.addEventListener('input', () => {
      root.style.setProperty('--ba', `${range.value}%`);
    });
  });
</script>

<style>
  .ba {
    position: relative;
    border-radius: var(--r-card);
    overflow: hidden;
    background: var(--accent-tint);
  }
  .ba :global(.ba-img),
  .ba :global(.ba-img img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ba-before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--ba)) 0 0);
  }

  .ba-chip {
    position: absolute;
    top: 24px;
    background: var(--surface);
    border-radius: var(--r-pill);
    padding: 8px 14px;
    color: var(--ink);
    box-shadow: 0 4px 14px rgba(20, 26, 36, 0.1);
    pointer-events: none;
  }
  .ba-chip-before {
    left: 24px;
  }
  .ba-chip-after {
    right: 24px;
  }

  .ba-divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--ba);
    width: 3px;
    margin-left: -1.5px;
    background: var(--surface);
    box-shadow: 0 0 14px rgba(20, 26, 36, 0.22);
    pointer-events: none;
  }
  .ba-handle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2px;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 6px 20px rgba(20, 26, 36, 0.18);
  }

  /* the whole exhibit is the control */
  .ba-range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    touch-action: pan-y;
    -webkit-appearance: none;
    appearance: none;
  }
  .ba-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 48px;
    height: 48px;
  }
  .ba:has(.ba-range:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (max-width: 900px) {
    .ba-chip {
      top: 12px;
      padding: 6px 10px;
    }
    .ba-chip-before {
      left: 12px;
    }
    .ba-chip-after {
      right: 12px;
    }
    .ba-handle {
      width: 40px;
      height: 40px;
    }
  }
</style>
