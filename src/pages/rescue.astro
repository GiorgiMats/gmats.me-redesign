---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import { SITE } from '../data/site';

import baBefore from '../assets/home/ba-before.png';
import baAfter from '../assets/home/ba-after.png';
import baFlowliftBefore from '../assets/rescue/ba-flowlift-before.png';
import baFlowliftAfter from '../assets/rescue/ba-flowlift-after.png';
import baBluffBefore from '../assets/rescue/ba-bluff-before.png';
import baBluffAfter from '../assets/rescue/ba-bluff-after.png';
import baDocketBefore from '../assets/rescue/ba-docket-before.png';
import baDocketAfter from '../assets/rescue/ba-docket-after.png';
import figTeardown from '../assets/rescue/fig-teardown.png';
import figFunnel from '../assets/rescue/fig-funnel.png';
import portrait from '../assets/home/portrait.png';
import recJoni from '../assets/rescue/rec-joni.png';
import recTom from '../assets/rescue/rec-tom.png';
import recOwen from '../assets/rescue/rec-owen.png';
import coverDocket from '../assets/home/cover-docket.png';
import coverBluff from '../assets/home/cover-bluff.png';
import coverFlowlift from '../assets/home/cover-flowlift.png';
import coverPaymentx from '../assets/home/cover-paymentx.png';

// TRUST SURFACE: no circle CTA, no playful moment, sober cells only.
// Off-nav and off-footer by IA contract — reachable via /#offer and
// campaign URLs only.
const title = 'Your product works. Now make it convert. · Giorgi Matsukatovi';
const description =
  'I take the app you built with Lovable, Bolt, v0 or Claude and rebuild the interface to the standard a paying customer expects. Fixes land inside your product, as changes you approve one by one.';

const proofCovers = [
  { label: 'DOCKET', href: '/project/docket', img: coverDocket, alt: 'Docket AML review console' },
  { label: 'BLUFF', href: '/project/bluff', img: coverBluff, alt: 'BLUFF casino home screen' },
  { label: 'FLOWLIFT', href: '/project/flowlift', img: coverFlowlift, alt: 'FlowLift dashboard' },
  { label: 'PAYMENTX', href: '/project/paymentx', img: coverPaymentx, alt: 'PaymentX marketing site' },
];

const symptoms = [
  'Four button styles, three primary.',
  'Spacing drifts screen to screen.',
  'Six type sizes doing three jobs.',
  'Empty states that look broken.',
  'A signup path nobody tested.',
];

const passes = [
  ['01', 'I walk your product', 'like a first-time user'],
  ['02', 'One fix per surface', 'take some, leave others'],
  ['03', 'The system stays', 'your builder keeps it on-system'],
];

const days = [
  ['key', 'DAY 1', 'You give me your site'],
  ['list-dashes', 'DAY 2', 'You get the full list of fixes'],
  ['rows', 'DAYS 3–10', 'I ship fixes, you approve them'],
  ['git-merge', 'DAY 10', 'Everything you approved is live'],
  ['chat-circle-dots', '+14 DAYS', 'I stay around for questions'],
];

const alts = [
  ['arrows-clockwise', 'Prompt it again', '2 evenings', 'something different, equally generic'],
  ['pen-nib', 'A freelancer', '3–4x', 'a Figma file, dev week not included'],
  ['buildings', 'An agency', '10x', '$15–40K and six weeks'],
];

const stories = [
  {
    caption: 'FLOWLIFT · LANDING PAGE HERO',
    before: baFlowliftBefore,
    beforeAlt: 'The FlowLift landing hero before the redesign',
    after: baFlowliftAfter,
    afterAlt: 'The FlowLift landing hero after the redesign',
  },
  {
    caption: 'BLUFF · HOME PAGE',
    before: baBluffBefore,
    beforeAlt: 'The BLUFF casino home before the redesign',
    after: baBluffAfter,
    afterAlt: 'The BLUFF casino home after the redesign',
    // Product-level outcomes, stated as his own count (P6 honesty rule).
    note: 'Product-level outcomes from the Bluff launch. My own count, per the case study.',
    stickers: [
      { value: '15%', label: 'REGISTRATION TO PLAY', tone: 'solid' },
      { value: '12%', label: 'ON REFERRED USERS', tone: 'outline' },
    ],
  },
  {
    caption: 'DOCKET · DASHBOARD',
    before: baDocketBefore,
    beforeAlt: 'The Docket case queue before the redesign',
    after: baDocketAfter,
    afterAlt: 'The Docket case queue after the redesign',
  },
];

const recs = [
  {
    quote:
      'He\u2019s one of the fastest, most meticulous designers I\u2019ve ever worked with \u2014 balancing pace with pixel-perfect execution in a way that makes complex projects feel effortlessly simple.',
    name: 'Joni Mortimore',
    role: 'Founding Designer',
    relation: 'WORKED ON THE SAME TEAM',
    avatar: recJoni,
  },
  {
    quote:
      'His work pairs careful visual craft with product thinking, and he understands that good design is about whether a feature actually gets used, not just how it looks.',
    name: 'Tom Jones',
    role: 'Director of Design, SuperDuper',
    relation: 'MANAGED GIORGI DIRECTLY',
    avatar: recTom,
  },
  {
    quote:
      'He brings a strong sense of product design principles and doesn\u2019t let them slip, even when timelines are tight. He\u2019s someone you can rely on to keep standards high while still getting work out the door.',
    name: 'Owen Manby',
    role: 'Delivery & Product Ops Lead',
    relation: 'WORKED ON THE SAME TEAM',
    avatar: recOwen,
  },
];

const askMail = `mailto:${SITE.email}?subject=${encodeURIComponent('My product link')}`;
---

<Base title={title} description={description}>
  <!-- s01 · headline + hero slider -->
  <section class="r-hero container">
    <p class="caps-r kicker">SENIOR PRODUCT DESIGNER · 6+ YEARS · THE PROOF IS BELOW, CHECKABLE</p>
    <h1>Your product works.<br />Now make it convert.</h1>
    <p class="r-lead">
      I take the app you built with Lovable, Bolt, v0 or Claude and rebuild the interface to the
      standard a paying customer expects. Fixes land inside your product, as changes you approve
      one by one.
    </p>
    <figure class="r-slider">
      <BeforeAfter
        before={baBefore}
        beforeAlt="The landing page as an AI build ships it: generic hero, grey blocks, no voice"
        after={baAfter}
        afterAlt="The same landing page redesigned: the real hero, staged in a browser"
        aspect="4 / 3"
        start={50}
      />
      <figcaption class="band-caption caps-r">
        <span>PAYMENTX · FIG. 01 · THE PUBLIC LANDING</span>
        <span>REAL PRODUCT SCREENS · NOT MOCKUPS</span>
      </figcaption>
    </figure>
  </section>

  <!-- s03 · identification -->
  <section class="r-identify container cv-auto">
    <h2 class="r-h2">You already know these</h2>
    <div class="identify-card">
      <div class="identify-art">
        <Picture
          src={figTeardown}
          widths={[720, 1200, 2400]}
          sizes="(max-width: 900px) 100vw, 1136px"
          formats={['avif', 'webp']}
          alt="A wireframed app screen with hand-drawn rings and arrows marking every place the interface breaks"
          loading="lazy"
        />
      </div>
      <ul class="symptoms" role="list">
        {
          symptoms.map((s) => (
            <li>
              <span class="dot" aria-hidden="true" />
              {s}
            </li>
          ))
        }
      </ul>
    </div>
    <p class="sympt-line">
      <span class="dot" aria-hidden="true"></span>
      And the sentence you say in demos, <strong>ignore how it looks</strong>, after which the call
      half-listens.
    </p>
  </section>

  <!-- s04 · what the look costs you -->
  <div class="r-cost-wrap cv-auto">
    <section class="r-cost">
      <p class="caps-r sect-label">WHAT THE LOOK COSTS YOU</p>
      <h2 class="r-h2-big">Visitors don’t file bugs.<br />They just leave.</h2>
      <div class="cost-row">
        <div class="cost-art">
          <Picture
            src={figFunnel}
            widths={[700, 1400]}
            sizes="(max-width: 900px) 100vw, 486px"
            formats={['avif', 'webp']}
            alt="A funnel with visitors walking in at the top and leaking out through a crack a designer is patching"
            loading="lazy"
          />
        </div>
        <ol class="passes">
          {
            passes.map(([num, head, sub]) => (
              <li>
                <span class="pass-num tnum">{num}</span>
                <div class="pass-txt">
                  <p class="pass-head">{head}</p>
                  <p class="pass-sub">{sub}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <details class="how">
        <summary>
          <span class="caps-r">HOW I DO IT</span>
          <Icon name="caret-right" size={14} class="how-caret" />
        </summary>
        <div class="how-body">
          <p class="how-para">
            A model writes each screen correctly and separately. It has no memory of screen 3 when
            it writes screen 9, so what you get is locally correct and globally incoherent. Nobody
            chose those four button styles, they accumulated.
          </p>
          <div class="incoherence" role="img" aria-label="Two wireframe screens with differently styled continue buttons and no memory between them">
            <div class="inc-screen">
              <p class="caps-r inc-label">SCREEN 3</p>
              <span class="inc-bar" aria-hidden="true"></span>
              <span class="inc-bar" aria-hidden="true"></span>
              <span class="inc-btn inc-btn-round">Continue</span>
            </div>
            <div class="inc-link" aria-hidden="true">
              <p class="caps-r">NO MEMORY BETWEEN THEM</p>
              <span class="inc-dashes"></span>
            </div>
            <div class="inc-screen">
              <p class="caps-r inc-label">SCREEN 9</p>
              <span class="inc-bar" aria-hidden="true"></span>
              <span class="inc-bar" aria-hidden="true"></span>
              <span class="inc-btn inc-btn-square">Continue</span>
            </div>
          </div>
          <p class="how-mechanism">
            I direct Claude Code against your product’s code myself, so every fix arrives as a
            change you can review, question and approve.
          </p>
          <p class="how-support">
            The AI workflows and skills behind it are built by me, for exactly this job. That is why
            the fixes land in days, not weeks.
          </p>
        </div>
      </details>
    </section>
  </div>

  <!-- s05 · the ten days -->
  <section class="r-days container cv-auto">
    <h2 class="r-h2">The ten days, day by day</h2>
    <div class="timeline">
      <div class="timeline-track" aria-hidden="true">
        <span class="track-fill"></span>
      </div>
      <ol class="timeline-steps">
        {
          days.map(([icon, day, txt], i) => (
            <li>
              <Icon name={icon} size={26} class="day-icon" />
              <p class="caps-r day-label tnum">{day}</p>
              <span class:list={['day-dot', { 'day-dot-open': i === days.length - 1 }]} aria-hidden="true" />
              <p class="day-txt">{txt}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- s06 · the alternatives -->
  <section class="r-alts container cv-auto">
    <h2 class="r-h2">The alternatives</h2>
    <div class="alt-cells">
      {
        alts.map(([icon, head, big, sub]) => (
          <div class="alt">
            <Icon name={icon} size={26} class="alt-icon" />
            <p class="alt-head">{head}</p>
            <p class="alt-big">{big}</p>
            <p class="alt-sub">{sub}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- s07a · success stories -->
  <section class="r-stories container cv-auto">
    <p class="caps-r sect-label">BEFORE / AFTER</p>
    <h2 class="r-h2-big">Success Stories</h2>
    <p class="stories-lead">
      Three real AI-built sites, redesigned by me end to end. The before is the site as it shipped;
      the after is what I would hand you.
    </p>
    {
      stories.map((story) => (
        <figure class="story">
          <div class="story-cells">
            <div class="story-cell">
              <Picture
                src={story.before}
                widths={[640, 1176, 2352]}
                sizes="(max-width: 900px) 100vw, 588px"
                formats={['avif', 'webp']}
                alt={story.beforeAlt}
                loading="lazy"
              />
              <span class="story-chip caps-r">BEFORE</span>
            </div>
            <div class="story-cell">
              <Picture
                src={story.after}
                widths={[640, 1176, 2352]}
                sizes="(max-width: 900px) 100vw, 588px"
                formats={['avif', 'webp']}
                alt={story.afterAlt}
                loading="lazy"
              />
              <span class="story-chip story-chip-after caps-r">AFTER</span>
            </div>
            {
              story.stickers?.map((sticker, i) => (
                <span class:list={['story-sticker', `story-sticker-${i + 1}`, `sticker-${sticker.tone}`]}>
                  <span class="sticker-value tnum">{sticker.value}</span>
                  <span class="sticker-label caps-r">{sticker.label}</span>
                </span>
              ))
            }
          </div>
          <figcaption class="story-caption caps-r">{story.caption}</figcaption>
          {story.note && <p class="story-note">{story.note}</p>}
        </figure>
      ))
    }
  </section>

  <!-- s07b · who does the work -->
  <section class="r-designer container cv-auto">
    <div class="designer-txt">
      <p class="caps-r sect-label">WHO DOES THE WORK</p>
      <h2 class="r-h2-big">The designer who built own SaaS to $3.5K MRR.</h2>
      <p class="designer-bio">
        Giorgi Matsukatovi, senior product designer in Tbilisi, 6+ years in. I started in front-end
        and still ship what I draw; the SaaS I built reached $3.5K in monthly recurring revenue.
        Along the way I have watched designers grow under me, which taught me more about judgment
        than any portfolio did.
      </p>
      <p class="designer-bio">
        I have done this on my own product. I built a subscription SaaS with one developer and grew
        it to about 70 paying subscribers and $3.5K a month. Every day I watched session recordings
        in Microsoft Clarity next to the analytics, found where people stalled, and fixed it. Over a
        few months the cost of getting one paying customer went from about $150 to about $50.
        <strong>That habit, look at what users actually do and then change the screen, is the whole
        method behind a rescue.</strong>
      </p>
      <a href="/about" class="arrow-link">
        More about me
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
    <div class="designer-portrait">
      <Picture
        src={portrait}
        widths={[360, 720]}
        sizes="(max-width: 900px) 100vw, 360px"
        formats={['avif', 'webp']}
        alt="Giorgi Matsukatovi, black and white portrait"
        loading="lazy"
      />
    </div>
  </section>

  <!-- s08 · recommendations -->
  <section class="r-recs container cv-auto">
    <h2 class="r-h2-big">From people I&rsquo;ve shipped with</h2>
    <div class="rec-cards">
      {
        recs.map((rec) => (
          <figure class="rec">
            <span class="rec-mark" aria-hidden="true">&ldquo;</span>
            <blockquote class="rec-quote">{rec.quote}</blockquote>
            <figcaption class="rec-by">
              <span class="rec-avatar">
                <Picture
                  src={rec.avatar}
                  widths={[44, 88]}
                  sizes="44px"
                  formats={['avif', 'webp']}
                  alt={`${rec.name}, ${rec.role}`}
                  loading="lazy"
                />
              </span>
              <span class="rec-who">
                <span class="rec-name">{rec.name}</span>
                <span class="rec-role">{rec.role}</span>
                <a
                  class="caps-r rec-rel"
                  href={SITE.linkedin}
                  target="_blank"
                  rel="noopener"
                  data-event="outbound_click"
                  data-channel="linkedin"
                  data-cta="false"
                >
                  {rec.relation} &middot; ON LINKEDIN
                </a>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <!-- s07 · real work -->
  <section class="r-proof container cv-auto">
    <h2 class="r-h2">Real Work</h2>
    <div class="proof-covers">
      {
        proofCovers.map((c) => (
          <a href={c.href} class="proof-case">
            <span class="proof-img">
              <Picture
                src={c.img}
                widths={[282, 564]}
                sizes="(max-width: 900px) 45vw, 282px"
                formats={['avif', 'webp']}
                alt={c.alt}
                loading="lazy"
              />
            </span>
            <span class="caps-r proof-label">{c.label}</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- s09 · the offers -->
  <section class="r-tiers cv-auto" id="offers">
    <div class="container">
      <h2 class="r-h2">The offers</h2>
      <div class="tier-cards">
        <article class="tier tier-lead">
          <p class="tier-band caps-r">RECOMMENDED · START HERE</p>
          <div class="tier-body">
            <h3>The Teardown</h3>
            <p class="tier-sub">See what’s costing you clients.</p>
            <div class="tier-price">
              <p class="price tnum">$750</p>
              <p class="caps-r price-terms">FIVE WORKING DAYS · FIXED</p>
            </div>
            <p class="caps-r inside-label">WHAT’S INSIDE</p>
            <ul class="inside">
              <li>Every place the coherence breaks, prioritised by what it costs you</li>
              <li>Each fix specified, ready to act on</li>
              <li>A document and a recorded walkthrough</li>
              <li class="inside-accent">The $750 comes off the rescue</li>
            </ul>
            <a
              href={askMail}
              class="pill pill-solid tier-cta"
              data-event="outbound_click"
              data-channel="email"
              data-cta="true"
            >
              Send your link
            </a>
          </div>
        </article>
        <article class="tier">
          <div class="tier-body">
            <h3>The Rescue</h3>
            <p class="tier-sub">Everything fixed, without hiring anyone.</p>
            <div class="tier-price">
              <p class="price tnum">$2,500</p>
              <p class="caps-r price-terms">TEN WORKING DAYS · HALF UP FRONT</p>
            </div>
            <p class="caps-r inside-label">WHAT’S INSIDE</p>
            <ul class="inside">
              <li>Everything the teardown found, implemented</li>
              <li>Fixes ship in your product, one per surface</li>
              <li>Tokens, components and a rules file, committed</li>
              <li>A recorded walkthrough of every call made</li>
              <li>Fourteen days of answers after handover</li>
            </ul>
          </div>
        </article>
        <article class="tier">
          <div class="tier-body">
            <h3>The Partner</h3>
            <p class="tier-sub">Keep me around after the rescue.</p>
            <div class="tier-price">
              <p class="price tnum">$3,000</p>
              <p class="caps-r price-terms">FROM, MONTHLY · TWO CLIENTS AT A TIME</p>
            </div>
            <p class="caps-r inside-label">WHAT’S INSIDE</p>
            <ul class="inside">
              <li>Ongoing design, same mechanism</li>
              <li>Two clients at a time, ever</li>
              <li>Priority answers, day in, day out</li>
            </ul>
          </div>
        </article>
      </div>
      <div class="guarantee">
        <Icon name="shield-star" size={56} class="guarantee-icon" />
        <div class="guarantee-txt">
          <h3>The Guarantee</h3>
          <p>
            Teardown without ten usable fixes: you do not pay. Rescue not shipped by day ten: I keep
            working, free.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- s12 · the ask -->
  <section class="r-ask container cv-auto">
    <h2>Send me a link to your product.</h2>
    <p class="ask-sub">
      The live URL, or the code repository if you have one. Within a business day you get a written
      reply naming the three things I would fix first and what the work costs. No call unless you
      want one.
    </p>
    <a
      href={askMail}
      class="pill pill-solid ask-cta"
      data-event="rescue_ask_click"
      data-cta="true"
    >
      Send your link
      <Icon name="arrow-up-right" size={16} />
    </a>
  </section>
</Base>

<style>
  .caps-r {
    font-size: var(--fs-caps-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
    line-height: var(--lh-caps);
    font-feature-settings: 'case' 1;
  }

  .sect-label {
    color: var(--ink-secondary);
  }

  .r-h2 {
    font-size: 2.25rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--ink);
  }
  .r-h2-big {
    margin-top: 20px;
    font-size: clamp(1.75rem, 3.35vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.14;
    color: var(--ink);
  }

  .arrow-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--accent);
  }
  .arrow-link:hover {
    color: var(--accent-bright);
  }

  .dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  /* ---- s01 hero ---- */
  .r-hero {
    padding-top: 88px;
    padding-bottom: 96px;
  }
  .r-hero h1 {
    margin-top: 32px;
    font-size: clamp(2.0625rem, 4.1vw, 3.6875rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.06;
    color: var(--ink);
  }
  .r-lead {
    margin-top: 28px;
    max-width: 640px;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--ink-secondary);
  }
  .r-slider {
    margin-top: 40px;
  }
  .band-caption {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 16px;
    color: var(--ink-secondary);
  }

  /* ---- s03 identify ---- */
  .r-identify {
    padding-bottom: 96px;
  }
  .identify-card {
    margin-top: 28px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    padding: 40px 32px 28px;
  }
  .identify-art {
    max-width: 880px;
    margin-inline: auto;
  }
  .identify-art :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
  .symptoms {
    list-style: none;
    padding: 24px 0 0;
    margin: 24px 0 0;
    border-top: 1px solid var(--border);
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 24px;
  }
  .symptoms li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--ink);
  }
  .symptoms .dot {
    margin-top: 6px;
  }
  .sympt-line {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-top: 28px;
    padding-inline: 8px;
    font-size: 1.125rem;
    color: var(--ink);
  }
  .sympt-line strong {
    font-weight: 600;
  }

  /* ---- s04 cost inset ---- */
  .r-cost-wrap {
    padding: 8px 24px;
  }
  .r-cost {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-inset);
    padding: 88px 96px;
    max-width: 1392px;
    margin-inline: auto;
  }
  .cost-row {
    margin-top: 48px;
    display: flex;
    gap: 56px;
    align-items: flex-start;
  }
  .cost-art {
    flex: 0 0 486px;
    background: var(--accent-tint);
