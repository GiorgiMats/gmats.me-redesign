---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';

import coverDocket from '../assets/home/cover-docket.png';
import coverBluff from '../assets/home/cover-bluff.png';
import coverFlowlift from '../assets/home/cover-flowlift.png';
import coverPaymentx from '../assets/home/cover-paymentx.png';

// TRUST SURFACE: no circle CTA, no playful moment, display ≤64px, sober
// cells only. Off-nav and off-footer by IA contract — reachable via /#offer
// and campaign URLs only.
const title = 'The Ship-Ready Rescue · Giorgi Matsukatovi';
const description =
  'Design fixes that land in your product, not in a Figma file. A senior product designer rebuilds the interface of your AI-built app as changes you approve one by one.';

const proofCovers = [
  { label: 'DOCKET', href: '/project/docket', img: coverDocket, alt: 'Docket AML review console' },
  { label: 'BLUFF', href: '/project/bluff', img: coverBluff, alt: 'BLUFF casino home screen' },
  { label: 'FLOWLIFT', href: '/project/flowlift', img: coverFlowlift, alt: 'FlowLift dashboard' },
  { label: 'PAYMENTX', href: '/project/paymentx', img: coverPaymentx, alt: 'PaymentX marketing site' },
];

const whatYouGet = [
  ['Day two', 'The fix list, prioritised by what it costs you'],
  ['Ten working days', 'Fixes shipped in your product, one per surface'],
  ['Committed', 'Tokens, components and a rules file'],
  ['Recorded', 'A walkthrough of every call made'],
  ['Fourteen days', 'Questions answered after handover'],
];

const askMail = `mailto:${SITE.email}?subject=${encodeURIComponent('My product link')}`;
---

<Base title={title} description={description}>
  <!-- s01 · mechanism headline -->
  <section class="r-hero container">
    <p class="caps-r kicker">SENIOR PRODUCT DESIGNER · 6+ YEARS · THE PROOF IS BELOW, CHECKABLE</p>
    <div class="r-hero-row">
      <div class="r-hero-left">
        <h1>
          Design fixes that land<br /><em>in your product,</em><br />not in a Figma file.
        </h1>
        <p class="r-lead">
          A senior product designer takes the app you built with Lovable, Bolt, v0 or Claude and
          rebuilds the interface to the standard a paying customer expects: <strong
            >spacing, type scale, hierarchy, button weight, empty and error states, the signup
            path</strong
          >. The fixes land inside your product, as changes you approve one by one. No handoff, no
          engineer time, nothing to rebuild.
        </p>
      </div>
      <div class="fig-pr" role="img" aria-label="Illustration: the shape of every fix: from your repository, through one reviewable fix, to shipped UI in your product">
        <p class="caps-r fig-label">THE SHAPE OF EVERY FIX · ILLUSTRATION</p>
        <p class="pr-chip caps-r">YOUR REPOSITORY</p>
        <div class="pr-arrow" aria-hidden="true">↓</div>
        <div class="pr-card">
          <p class="caps-r pr-card-label">ONE FIX · ONE SURFACE</p>
          <p class="pr-title">fix: one primary button per screen</p>
          <div class="pr-diff" aria-hidden="true">
            <span class="diff-add"></span>
            <span class="diff-del"></span>
          </div>
          <p class="caps-r pr-count tnum">+214 −380</p>
          <ul class="pr-checks">
            <li>You see it</li>
            <li>You question it</li>
            <li>You approve it</li>
          </ul>
          <p class="pr-merged caps-r">APPROVED</p>
        </div>
        <div class="pr-arrow" aria-hidden="true">↓</div>
        <p class="pr-chip pr-chip-ship caps-r">SHIPPED UI, IN YOUR PRODUCT</p>
      </div>
    </div>
  </section>

  <!-- s03 · identification -->
  <section class="r-sympt container cv-auto">
    <p class="caps-r sect-label">YOU ALREADY KNOW THESE</p>
    <div class="sympt-bento">
      <div class="sympt-cell">
        <div class="sympt-canvas sympt-buttons" aria-hidden="true">
          <span class="b b-solid">Save</span>
          <span class="b b-outline">Save</span>
          <span class="b b-square">SAVE</span>
          <span class="b b-soft">Save changes</span>
        </div>
        <p class="sympt-cap">Four button styles on one page, three reading as primary.</p>
      </div>
      <div class="sympt-cell">
        <div class="sympt-canvas sympt-spacing" aria-hidden="true">
          <span style="margin-left: 4px"></span>
          <span style="margin-left: 11px"></span>
          <span style="margin-left: 0"></span>
          <span style="margin-left: 18px"></span>
        </div>
        <p class="sympt-cap">Spacing that drifts a few pixels per section.</p>
      </div>
      <div class="sympt-cell">
        <div class="sympt-canvas sympt-type" aria-hidden="true">
          <span style="font-size: 36px">Aa</span>
          <span style="font-size: 21px">Aa</span>
          <span style="font-size: 29px">Aa</span>
          <span style="font-size: 15px">Aa</span>
          <span style="font-size: 25px">Aa</span>
          <span style="font-size: 12px">Aa</span>
        </div>
        <p class="sympt-cap">Six type sizes where three would carry the product.</p>
      </div>
      <div class="sympt-cell">
        <div class="sympt-canvas sympt-empty" aria-hidden="true">
          <span class="empty-box">No data</span>
        </div>
        <p class="sympt-cap">Empty states that say “No data” and look like something broke.</p>
      </div>
    </div>
    <p class="sympt-line">
      <span class="dot" aria-hidden="true"></span>
      <span
        >And the sentence you say in demos, <strong>ignore how it looks</strong>, after which the
        call half-listens.</span
      >
    </p>
  </section>

  <!-- s04 · mechanism, sold -->
  <div class="r-mech-wrap cv-auto">
    <section class="r-mech">
      <p class="caps-r sect-label">WHY IT LOOKS GENERATED, AND WHAT I DO ABOUT IT</p>
      <p class="mech-reason">
        A model writes each screen correctly and separately. It has no memory of screen 3 when it
        writes screen 9, so what you get is locally correct and globally incoherent. Nobody chose
        those four button styles, they accumulated.
      </p>
      <div class="fig-inco" role="img" aria-label="Illustration: two screens, each internally neat, with no memory between them: screen 3 uses a blue pill button, screen 9 an ink square button">
        <div class="inco-screen">
          <p class="caps-r">SCREEN 3</p>
          <span class="bar"></span>
          <span class="bar"></span>
          <span class="inco-btn inco-pill">Continue</span>
        </div>
        <div class="inco-link" aria-hidden="true">
          <p class="caps-r">NO MEMORY BETWEEN THEM</p>
          <span class="dashes"></span>
        </div>
        <div class="inco-screen">
          <p class="caps-r">SCREEN 9</p>
          <span class="bar"></span>
          <span class="bar"></span>
          <span class="inco-btn inco-square">Continue</span>
        </div>
      </div>
      <p class="mech-canon">
        I direct Claude Code against your product’s code myself, so every fix arrives as a change
        you can review, question and approve.
      </p>
      <ol class="passes">
        <li>
          <span class="pass-num tnum">01</span>
          <p><strong>I walk the product the way a first-time user does</strong> and write down where the coherence breaks.</p>
        </li>
        <li>
          <span class="pass-num tnum">02</span>
          <p><strong>One fix per surface, shipped separately</strong> so you can take some and leave others.</p>
        </li>
        <li>
          <span class="pass-num tnum">03</span>
          <p><strong>Tokens and a rules file go in</strong> so your builder keeps generating on-system UI after I go.</p>
        </li>
      </ol>
      <p class="mech-yourpart">
        Your part: access to the code, thirty minutes on day one, and answers on open fixes within
        a business day.
      </p>
    </section>
  </div>

  <!-- s05 · what you get -->
  <section class="r-get container cv-auto">
    <p class="caps-r sect-label">WHAT YOU GET</p>
    <div class="fig-timeline" role="img" aria-label="Ten-day timeline: day 1 access, day 2 fix list, days 3 to 10 fixes shipping, day 10 agreed list merged, plus 14 days of questions answered">
      <div class="tl-track" aria-hidden="true"><span class="tl-fill" data-fill="69%"></span></div>
      <div class="tl-stop" style="left: 4%">
        <p class="caps-r tl-day">DAY 1</p>
        <span class="tl-dot"></span>
        <p class="tl-desc">Access + 30 minutes</p>
      </div>
      <div class="tl-stop" style="left: 23%">
        <p class="caps-r tl-day">DAY 2</p>
        <span class="tl-dot"></span>
        <p class="tl-desc">The fix list lands</p>
      </div>
      <div class="tl-stop" style="left: 47%">
        <p class="caps-r tl-day tnum">DAYS 3–10</p>
        <span class="tl-dot"></span>
        <p class="tl-desc">One fix per surface, shipped separately</p>
      </div>
      <div class="tl-stop" style="left: 68%">
        <p class="caps-r tl-day">DAY 10</p>
        <span class="tl-dot"></span>
        <p class="tl-desc">Agreed list merged</p>
      </div>
      <div class="tl-stop tl-stop-after" style="left: 91%">
        <p class="caps-r tl-day tnum">+14 DAYS</p>
        <span class="tl-dot tl-dot-open"></span>
        <p class="tl-desc">Questions answered</p>
      </div>
    </div>
    <dl class="get-rows">
      {
        whatYouGet.map(([key, value]) => (
          <div class="get-row">
            <dt>{key}</dt>
            <dd>{value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- s06 · the alternatives, costed -->
  <section class="r-alts container cv-auto">
    <p class="caps-r sect-label">THE ALTERNATIVES, COSTED</p>
    <div class="alt-cells">
      <div class="alt">
        <p class="alt-title">Prompt it again</p>
        <p class="alt-desc">Something different and equally generic, two evenings gone.</p>
      </div>
      <div class="alt">
        <p class="alt-title">A freelancer</p>
        <p class="alt-desc">A Figma file, plus a developer week you still have to fund.</p>
      </div>
      <div class="alt">
        <p class="alt-title">An agency</p>
        <p class="alt-desc">Ten thousand dollars and six weeks. You launch before that.</p>
      </div>
    </div>
  </section>

  <!-- s07 · proof -->
  <section class="r-proof container cv-auto">
    <p class="caps-r sect-label">PROOF · ARTEFACTS FIRST, EVERY ITEM CHECKABLE</p>
    <div class="proof-covers">
      {
        proofCovers.map((c) => (
          <a class="proof-case" href={c.href}>
            <div class="proof-img exhibit">
              <Picture
                src={c.img}
                widths={[282, 564]}
                sizes="(max-width: 900px) 50vw, 282px"
                formats={['avif', 'webp']}
                alt={c.alt}
                loading="lazy"
              />
            </div>
            <p class="caps-r proof-label">{c.label}</p>
          </a>
        ))
      }
    </div>
    <p class="proof-para">
      Bluff, an iGaming product whose company raised $21M. I owned signup, deposit and withdrawal,
      mapped 24 or more failure conditions across email, phone and OTP, and designed the UI for
      twelve in-house games, over fifteen months mostly spent improving work I had already
      improved.
    </p>
    <p class="proof-para">
      PaymentX, a two-sided B2B payments marketplace from zero. Docket, an AI compliance-review
      console, shipping now. FlowLift, built end to end in seven days by directing AI, around 60
      screens, 4 platforms, one design system, <strong>no users and invented data</strong>, so it
      shows coherence under speed and nothing about retention.
    </p>
  </section>

  <!-- s08 · deadly sincerity -->
  <section class="r-sincerity container cv-auto">
    <p class="caps-r sect-label">WHAT THIS WILL NOT FIX</p>
    <div class="sincerity-card">
      <p>
        This does not fix a product nobody wants, or your pricing, or a backend that falls over
        under load. Keep generating screens without the rules file and the drift is back inside a
        month. There is also a version that goes too far, a product too pleased with itself, which
        is its own bad decision, so I stop where the interface stops arguing with the work.
      </p>
    </div>
  </section>

  <!-- s09 · tiers -->
  <section class="r-tiers cv-auto">
    <div class="container">
      <p class="caps-r sect-label">THE OFFERS · THE TEARDOWN LEADS</p>
      <div class="tier tier-lead">
        <div class="tier-txt">
          <p class="tier-tag caps-r">PHASE ONE OF EVERYTHING</p>
          <h2>The Ship-Ready Teardown</h2>
          <p class="tier-desc">
            Five working days. Every place the coherence breaks, prioritised by what it costs you,
            each fix specified, as a document and a walkthrough. The fee comes off the rescue.
          </p>
        </div>
        <div class="tier-num">
          <p class="tier-price tnum">$750</p>
          <p class="caps-r tier-basis">FIVE WORKING DAYS · FIXED</p>
        </div>
      </div>
      <div class="tier">
        <div class="tier-txt">
          <h2>The 10-Day Ship-Ready Rescue</h2>
          <p class="tier-desc">
            Ten working days, half up front. Everything above, implemented inside your product as
            changes you approve one by one.
          </p>
        </div>
        <div class="tier-num">
          <p class="tier-price tnum">$2,500</p>
          <p class="caps-r tier-basis">TEN WORKING DAYS · HALF UP FRONT</p>
        </div>
      </div>
      <div class="tier">
        <div class="tier-txt">
          <h2>Design partner</h2>
          <p class="tier-desc">From three thousand a month, two clients at a time.</p>
        </div>
        <div class="tier-num">
          <p class="tier-price tnum">$3,000</p>
          <p class="caps-r tier-basis">FROM, MONTHLY · TWO CLIENTS AT A TIME</p>
        </div>
      </div>
    </div>
  </section>

  <!-- s10 · risk reversal -->
  <section class="r-guarantee container cv-auto">
    <p class="caps-r sect-label">THE GUARANTEE, DATED AND SPECIFIC</p>
    <div class="guarantee-card">
      <p>
        If the teardown does not contain ten fixes you can act on this week, you do not pay for
        it. On the rescue: give me access to the code, thirty minutes on day one and answers on
        open fixes within a business day, and if the agreed fix list is not shipped by day ten, I
        keep working free until it is.
      </p>
    </div>
    <p class="caps-r capacity tnum">TWO RESCUES A MONTH · ONE STARTS ON THE 1ST · ONE ON THE 15TH</p>
  </section>

  <!-- s12 · the one ask -->
  <section class="r-ask container cv-auto">
    <h2>Send me a link to your product.</h2>
    <p class="ask-sub">
      The live URL, or the code repository if you have one. Within a business day you get a
      written reply naming the three things I would fix first and what the work costs. No call
      unless you want one.
    </p>
    <a
      href={askMail}
      class="pill pill-solid ask-cta"
      data-event="rescue_ask_click"
      data-channel="email"
      data-cta="true"
    >
      Send your link
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
        <path d="M2 10L10 2M10 2H4M10 2V8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>
  </section>

  <script src="../scripts/stat-motion.ts"></script>
</Base>

<style>
  .caps-r {
    font-size: var(--fs-caps-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
    line-height: var(--lh-caps);
    font-feature-settings: 'case' 1;
    color: var(--ink-secondary);
  }
  .sect-label {
    font-size: var(--fs-caps);
  }

  /* ---- s01 hero ---- */
  .r-hero {
    padding-top: 88px;
    padding-bottom: 72px;
  }
  .kicker {
    margin-bottom: 47px;
  }
  .r-hero-row {
    display: flex;
    justify-content: space-between;
    gap: 64px;
  }
  .r-hero-left {
    max-width: 760px;
  }
  .r-hero h1 {
    font-size: clamp(2.0625rem, 4vw, 3.625rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.02;
    color: var(--ink);
    text-wrap: initial;
  }
  .r-hero em {
    font-style: normal;
    color: var(--accent);
  }
  .r-lead {
    margin-top: 28px;
    max-width: 640px;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--ink-secondary);
  }
  .r-lead strong {
    color: var(--ink);
  }

  .fig-pr {
    flex-shrink: 0;
    width: 480px;
    background: var(--cobalt-tint);
    border-radius: var(--r-cell);
    padding: 20px 24px 24px;
  }
  .fig-label {
    font-size: var(--fs-caps-xs);
    margin-bottom: 16px;
  }
  .pr-chip {
    display: inline-block;
    background: var(--ink);
    color: #fff;
    border-radius: var(--r-pill);
    padding: 10px 16px;
  }
  .pr-chip-ship {
    background: var(--surface);
    color: var(--accent);
    border: 1px solid var(--accent);
  }
  .pr-arrow {
    margin: 10px 0 10px 34px;
    color: var(--ink-secondary);
    font-size: 18px;
    line-height: 1;
  }
  .pr-card {
    position: relative;
    background: var(--surface);
    border-radius: 16px;
    padding: 18px 20px 20px;
    box-shadow: var(--shadow-exhibit);
  }
  .pr-card-label {
    font-size: var(--fs-caps-xs);
  }
  .pr-title {
    margin-top: 8px;
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--ink);
  }
  .pr-diff {
    display: flex;
    gap: 4px;
    margin-top: 13px;
  }
  .diff-add {
    width: 150px;
    height: 8px;
    border-radius: 4px;
    background: #15803d;
  }
  .diff-del {
    width: 90px;
    height: 8px;
    border-radius: 4px;
    background: #b91c1c;
  }
  .pr-count {
    margin-top: 8px;
    font-size: var(--fs-caps-xs);
  }
  .pr-checks {
    list-style: none;
    padding: 0;
    margin: 14px 0 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .pr-checks li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.875rem;
    color: var(--ink);
  }
  .pr-checks li::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }
  .pr-merged {
    position: absolute;
    right: 15px;
    bottom: 20px;
    background: var(--accent);
    color: #fff;
    border-radius: var(--r-pill);
    padding: 8px 14px;
    font-size: var(--fs-caps-xs);
  }

  /* ---- s03 symptoms ---- */
  .r-sympt {
    padding-top: 64px;
    padding-bottom: 48px;
  }
  .sympt-bento {
    margin-top: 18px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .sympt-cell {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    padding: 24px;
    min-height: 268px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .sympt-cap {
    font-size: 0.875rem;
    color: var(--ink);
    margin-top: 24px;
  }
  .sympt-canvas {
    padding-top: 32px;
  }

  .sympt-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: flex-start;
    max-width: 460px;
  }
  .b {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding: 0 32px;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .b-solid {
    background: var(--cobalt);
    color: #fff;
    border-radius: var(--r-pill);
  }
  .b-outline {
    border: 1px solid var(--ink);
    color: var(--ink);
    border-radius: var(--r-pill);
  }
  .b-square {
    background: var(--ink);
    color: #fff;
    border-radius: 4px;
  }
  .b-soft {
    background: var(--sunken);
    color: var(--ink-secondary);
    border-radius: 10px;
  }

  .sympt-spacing {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .sympt-spacing span {
    display: block;
    width: 300px;
    height: 26px;
    border-radius: 6px;
    background: var(--sunken);
  }

  .sympt-type {
    display: flex;
    align-items: baseline;
    gap: 26px;
    font-weight: 500;
    color: var(--ink);
  }

  .sympt-empty {
    display: flex;
    justify-content: center;
  }
  .empty-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 300px;
    height: 120px;
    border-radius: 12px;
    background: var(--sunken);
    color: var(--ink-secondary);
    font-size: 0.875rem;
  }

  .sympt-line {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 32px;
    font-size: 1.125rem;
    color: var(--ink);
  }
  .sympt-line .dot {
    flex-shrink: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* ---- s04 mechanism ---- */
  .r-mech-wrap {
    padding: 8px 24px;
  }
  .r-mech {
    max-width: 1392px;
    margin-inline: auto;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-inset);
    padding: 88px 96px;
  }
  .mech-reason {
    margin-top: 28px;
    max-width: 880px;
    font-size: 1.1875rem;
    line-height: 1.65;
    color: var(--ink);
  }

  .fig-inco {
    margin-top: 28px;
    max-width: 880px;
    display: flex;
    align-items: center;
    gap: 16px;
    background: var(--cobalt-tint);
    border-radius: var(--r-card);
    padding: 40px 60px;
  }
  .inco-screen {
    flex-shrink: 0;
    width: 300px;
    background: var(--surface);
    border-radius: 12px;
    padding: 14px 16px 20px;
    box-shadow: var(--shadow-exhibit);
  }
  .inco-screen .caps-r {
    font-size: var(--fs-caps-xs);
  }
  .inco-screen .bar {
    display: block;
    width: 200px;
    height: 10px;
    border-radius: 5px;
    background: var(--sunken);
    margin-top: 10px;
  }
  .inco-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 36px;
    margin-top: 28px;
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .inco-pill {
    width: 120px;
    background: var(--cobalt);
    color: #fff;
    border-radius: var(--r-pill);
  }
  .inco-square {
    width: 150px;
    background: var(--ink);
    color: #fff;
    border-radius: 4px;
  }
  .inco-link {
    flex: 1;
