---
import Base from '../../layouts/Base.astro';
import WorkGrid from '../../components/WorkGrid.astro';

const title = 'Work · Giorgi Matsukatovi';
const description =
  'Four products, receipts on the face: an AML review console, a live casino’s money flows, a four-platform sprint and a payments marketplace designed from zero.';
---

<Base title={title} description={description}>
  <section class="index-hero container">
    <h1>Four products. <em>Receipts</em> on the face.</h1>
  </section>
  <section class="index-work" aria-label="All projects">
    <WorkGrid />
  </section>
</Base>

<style>
  .index-hero {
    padding-top: 88px;
    padding-bottom: 40px;
  }
  .index-hero h1 {
    font-size: clamp(2.0625rem, 3.9vw, 3.5rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .index-hero em {
    font-style: normal;
    color: var(--accent);
  }
  .index-work {
    padding-bottom: 140px;
  }
  @media (max-width: 900px) {
    .index-hero {
      padding-top: 32px;
    }
    .index-work {
      padding-bottom: 80px;
    }
  }
</style>
