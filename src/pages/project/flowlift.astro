---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ArtefactButtons from '../../components/ArtefactButtons.astro';
import SandwichClose from '../../components/SandwichClose.astro';
import { cases } from '../../data/cases';
import '../../styles/dossier.css';

import mockHero from '../../assets/flowlift/mock-hero.png';
import mockZigA from '../../assets/flowlift/mock-zig-a.png';
import mockZigB from '../../assets/flowlift/mock-zig-b.png';
import mockSystem from '../../assets/flowlift/mock-system.png';
import mockProof from '../../assets/flowlift/mock-proof.png';
import mockCopilot from '../../assets/flowlift/mock-copilot.png';
import mockTablet from '../../assets/flowlift/mock-tablet.png';
import mockPhoneA from '../../assets/flowlift/mock-phone-a.png';
import mockPhoneB from '../../assets/flowlift/mock-phone-b.png';
import mockOnboarding from '../../assets/flowlift/mock-onboarding.png';
import marketingFull1 from '../../assets/flowlift/marketing-full-1.png';
import marketingFull2 from '../../assets/flowlift/marketing-full-2.png';

const c = cases.flowlift;

const wfStages = [
  { t: 'Brief', sub: 'the problem, the scope, the bar' },
  { t: 'Research swarm', sub: 'many agents + adversarial skeptics' },
  { t: 'I lock strategy', sub: 'the call only I can make', gate: true },
  { t: 'Design system', sub: 'tokens, then components' },
  { t: 'Screens', sub: 'built to consume the system' },
  { t: 'Adversarial QA', sub: 'reviewers hunt for defects' },
];
---

<Base title={c.metaTitle} description={c.metaDescription} caseTheme="flowlift" ogImage="/og/flowlift.png">
  <!-- hero -->
  <section class="d-hero container">
    <p class="d-chip">(CASE 03 · SELF-INITIATED · 7 DAYS)</p>
    <h1 class="fl-h1">Seven days from nothing to <em>four platforms.</em></h1>
    <p class="d-intro">
      FlowLift is a B2B SaaS activation layer designed and built end to end in seven days, with me
      directing AI workflows: research, strategy, a design system, and roughly 60 screens across
      desktop, tablet, mobile web and native iOS.
    </p>
    <div class="fl-disclosure">
      <p class="d-caps fl-disclosure-label">STATED FIRST</p>
      <p>
        FlowLift has no users. The customer in every screen, InvoicePilot, is invented, and its
        data is a single hand-reconciled dataset, not a live feed. Nothing here is validated by
        behaviour, what this case proves is decision quality and delivery.
      </p>
    </div>
    <dl class="fl-kv">
      <div>
        <dt class="d-caps">ROLE</dt>
        <dd>Designer, directing AI workflows</dd>
      </div>
      <div>
        <dt class="d-caps">CLIENT</dt>
        <dd>Self-initiated</dd>
      </div>
      <div>
        <dt class="d-caps">TIMELINE</dt>
        <dd>Seven days, 2026</dd>
      </div>
      <div>
        <dt class="d-caps">BASIS</dt>
        <dd>No users, invented data</dd>
      </div>
    </dl>
    <p class="fl-receipts tnum">~60 SCREENS · 4 PLATFORMS · 7 DAYS · 1 DESIGN SYSTEM</p>
    <div class="day-rail" role="img" aria-label="Seven-day rail from day one to day seven">
      <span class="d-caps rail-day tnum">DAY 01</span>
      <span class="rail-dots" aria-hidden="true">
        <span class="rail-dot rail-dot-end"></span>
        <span class="rail-dot"></span>
        <span class="rail-dot"></span>
        <span class="rail-dot"></span>
        <span class="rail-dot"></span>
        <span class="rail-dot"></span>
        <span class="rail-dot rail-dot-end"></span>
      </span>
      <span class="d-caps rail-day tnum">DAY 07</span>
    </div>
    <div class="d-hero-artefacts">
      <ArtefactButtons slug="flowlift" />
    </div>
  </section>

  <!-- hero exhibit -->
  <section class="container fl-hero-exh">
    <figure>
      <div class="d-cell" style="view-transition-name: cover-flowlift">
        <Picture
          src={mockHero}
          widths={[792, 1584]}
          sizes="(max-width: 900px) 100vw, 1200px"
          formats={['avif', 'webp']}
          alt="The FlowLift dashboard staged in a browser, rendered on InvoicePilot, the invented customer"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <figcaption class="fig-caption">
        FIG. 01 · THE DASHBOARD — INVOICEPILOT, THE INVENTED CUSTOMER, RENDERED IN FULL
      </figcaption>
    </figure>
  </section>

  <!-- LOG 01 -->
  <div class="log container cv-auto">
    <div class="log-left">
      <span class="log-num tnum">LOG 01</span>
      <span class="log-name">The thesis kill</span>
    </div>
    <span class="log-ghost tnum" aria-hidden="true">01</span>
  </div>
  <section class="fl-body container cv-auto">
    <h2 class="m-claim">The first thesis didn’t survive research.</h2>
    <p class="m-para">
      The week began with an adversarial pass on my own idea. The starting thesis, an all-in-one
      Conversion OS, went to research agents whose job was to break it, and it broke: too big to
      trust, and competing with the stack a buyer already runs. What survived was smaller and
      sharper: <strong>an activation layer on top of the analytics you already have</strong>.
      Keep your stack, we tell you what to fix.
    </p>
    <figure class="fl-wide">
      <div class="wf-board">
        <div class="wf-track">
          {
            wfStages.map((stage, i) => (
              <>
                {i > 0 && (
                  <span class="wf-arrow" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                      <path d="M2 9h13m0 0-5-5m5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                )}
                <span class:list={['wf-stage', { 'wf-gate': stage.gate }]}>
                  <span class="wf-stage-t">{stage.t}</span>
                  <span class="wf-stage-s">{stage.sub}</span>
                </span>
              </>
            ))
          }
        </div>
      </div>
      <figcaption class="fig-caption">
        FIG. 02 · THE WEEK’S WORKFLOW — EVERY PATH RUNS THROUGH A JUDGMENT GATE
      </figcaption>
    </figure>
  </section>

  <!-- LOG 02 -->
  <div class="log container cv-auto">
    <div class="log-left">
      <span class="log-num tnum">LOG 02</span>
      <span class="log-name">System before screens</span>
    </div>
    <span class="log-ghost tnum" aria-hidden="true">02</span>
  </div>
  <section class="fl-body container cv-auto">
    <h2 class="m-claim">No screen existed before the system.</h2>
    <p class="m-para">
      Tokens first, then atoms with every state designed, buttons through avatars, each with
      default, hover, focus, pressed, disabled, error, empty and loading, then molecules, then
      screens assembled only from approved parts. The tempting shortcut, per-platform components,
      <strong>was killed on day one</strong>: faster for the first twenty screens, unmaintainable
      by the sixtieth. When a component changed, sixty screens changed with it.
    </p>
    <div class="fl-scene d-cell">
      <Picture
        src={mockSystem}
        widths={[800, 1600]}
        sizes="(max-width: 900px) 100vw, 1104px"
        formats={['avif', 'webp']}
        alt="The atoms sheet from the design system, staged on the case green: buttons, inputs, selects and states, token-bound"
        loading="lazy"
      />
    </div>
    <p class="fig-caption">
      FIG. 03 · THE ATOMS — EVERY STATE, TOKEN-BOUND, BEFORE A SINGLE SCREEN
    </p>
  </section>

  <!-- LOG 03 -->
  <div class="log container cv-auto">
    <div class="log-left">
      <span class="log-num tnum">LOG 03</span>
      <span class="log-name">The product</span>
    </div>
    <span class="log-ghost tnum" aria-hidden="true">03</span>
  </div>
  <section class="fl-body container cv-auto" data-reach="case_proof_reach" data-case="flowlift">
    <h2 class="m-claim">Leaks, ranked by what they cost.</h2>
    <p class="m-para">
      The dashboard ranks trial-funnel leaks in dollars, rendered on InvoicePilot, the invented
      customer whose one hand-reconciled dataset sits behind every screen. The product’s signature
      came from a rejection: the first funnel visual was a generic bar chart, and
      <strong>I killed it for a custom activation-path diagram</strong>, green for trials that
      connected, coral for the ones that leaked. And every AI suggestion in the product carries
      Apply and Dismiss, a number-backed rationale and an audit trail, because an assistant that
      cannot show its work cannot be trusted with revenue.
    </p>
    <div class="zig">
      <div class="zig-row">
        <div class="d-cell zig-img">
          <Picture
            src={mockZigA}
            widths={[760, 1520]}
            sizes="(max-width: 900px) 100vw, 760px"
            formats={['avif', 'webp']}
            alt="The leak ranking staged in a browser: every leak is a row with a dollar figure and an owner"
            loading="lazy"
          />
        </div>
        <div class="zig-cap">
          <p class="d-caps">FIG. 04 · THE LEAK RANKING</p>
          <p>
            Every leak is a row with a dollar figure and an owner. The interface argues in money
            because that is the language a buyer already trusts.
          </p>
        </div>
      </div>
      <div class="zig-row zig-row-flip">
        <div class="d-cell zig-img">
          <Picture
            src={mockZigB}
            widths={[760, 1520]}
            sizes="(max-width: 900px) 100vw, 760px"
            formats={['avif', 'webp']}
            alt="The leak detail staged in a browser, with the activation-path diagram and cohort heatmap"
            loading="lazy"
          />
        </div>
        <div class="zig-cap">
          <p class="d-caps">FIG. 05 · LEAK DETAIL</p>
          <p>
            The activation-path diagram that replaced the bar chart: green for connected trials,
            coral for the leak, a cohort heatmap underneath.
          </p>
        </div>
      </div>
    </div>
    <div class="fl-bento-2">
      <div class="d-cell">
        <Picture
          src={mockProof}
          widths={[588, 1176]}
          sizes="(max-width: 900px) 100vw, 588px"
          formats={['avif', 'webp']}
          alt="The fix proof staged in a browser: treated versus control, with the shipped nudge beside the chart"
          loading="lazy"
        />
      </div>
      <div class="d-cell">
        <Picture
          src={mockCopilot}
          widths={[588, 1176]}
          sizes="(max-width: 900px) 100vw, 588px"
          formats={['avif', 'webp']}
          alt="The copilot staged in a browser: an answer with its sources and audit trail listed"
          loading="lazy"
        />
      </div>
    </div>
    <p class="fig-caption">
      FIG. 06 · PROOF AND COPILOT — TREATED VS CONTROL, AND AN ASSISTANT THAT SHOWS ITS SOURCES
    </p>
  </section>

  <!-- LOG 04 -->
  <div class="log container cv-auto">
    <div class="log-left">
      <span class="log-num tnum">LOG 04</span>
      <span class="log-name">Four platforms</span>
    </div>
    <span class="log-ghost tnum" aria-hidden="true">04</span>
  </div>
  <section class="fl-body container cv-auto">
    <h2 class="m-claim">One grammar survived four platforms.</h2>
    <p class="m-para">
      Desktop, tablet, mobile web and native iOS, including a lock-screen live activity and a
      home-screen widget, all reflowed from the same tokens and the same data hierarchy.
      <strong>Which platform was allowed to be ugly was decided on day one</strong>, before a
      single screen could argue about it.
    </p>
    <div class="fl-bento-2">
      <div class="d-cell">
        <Picture
          src={mockTablet}
          widths={[588, 1176]}
          sizes="(max-width: 900px) 100vw, 588px"
          formats={['avif', 'webp']}
          alt="The dashboard on a tablet, staged"
          loading="lazy"
        />
      </div>
      <div class="d-cell">
        <Picture
          src={mockPhoneA}
          widths={[588, 1176]}
          sizes="(max-width: 900px) 100vw, 588px"
          formats={['avif', 'webp']}
          alt="The dashboard on a phone, staged"
          loading="lazy"
        />
      </div>
    </div>
    <p class="fig-caption">FIG. 07 · TABLET AND MOBILE — ONE GRAMMAR AT EVERY WIDTH</p>
  </section>

  <!-- LOG 05 -->
  <div class="log container cv-auto">
    <div class="log-left">
      <span class="log-num tnum">LOG 05</span>
      <span class="log-name">The public face</span>
    </div>
    <span class="log-ghost tnum" aria-hidden="true">05</span>
  </div>
  <section class="fl-body container cv-auto">
    <h2 class="m-claim">The pitch is the product’s own words.</h2>
    <p class="m-para">
      The surviving thesis became the homepage, almost word for word: keep your stack, we tell
      you what to fix. The marketing site is drawn from the same tokens and components as the
      product, and the numbers on it are InvoicePilot’s, labelled invented like everything else.
      <strong>One system draws the product and the pitch.</strong>
    </p>
    <div class="d-cell exhibit fl-landing-scroll" tabindex="0" role="region" aria-label="The full marketing landing page, scrollable">
      <Picture
        src={marketingFull1}
        widths={[792, 1584]}
        sizes="(max-width: 900px) 100vw, 1104px"
        formats={['avif', 'webp']}
        alt="The marketing landing page, upper half: the activation-layer pitch, the leak diagram and the product tour"
        loading="lazy"
      />
      <Picture
        src={marketingFull2}
        widths={[792, 1584]}
        sizes="(max-width: 900px) 100vw, 1104px"
        formats={['avif', 'webp']}
        alt="The marketing landing page, lower half: proof, pricing and the closing call to connect a data source"
        loading="lazy"
      />
    </div>
    <p class="fig-caption">FIG. 08 · THE MARKETING SITE, IN FULL — SCROLL THE FRAME</p>
  </section>

  <!-- LOG 06 -->
  <div class="log container cv-auto">
    <div class="log-left">
      <span class="log-num tnum">LOG 06</span>
      <span class="log-name">The honest week</span>
    </div>
    <span class="log-ghost tnum" aria-hidden="true">06</span>
  </div>
  <section class="fl-body container cv-auto">
    <h2 class="m-claim">The AI was fast and frequently wrong.</h2>
    <p class="m-para">
      The week was me directing it. I set the bar, originated the strategy, caught the misses and
      made every accept or reject call, and reviewer agents audited the builder agents before
      anything reached me. The split was deliberate: judgment stayed mine, and the volume work
      went to the workflows.
      <strong
        >When the production cost of a screen falls to near zero, the value moves entirely to the
        decisions</strong
      >.
    </p>
    <div class="split-table">
      <div class="split-col">
        <p class="d-caps split-head split-head-mine">JUDGMENT · MINE</p>
        <ul>
          <li>Positioning and product strategy</li>
          <li>Information architecture</li>
          <li>Brand, colour and type direction</li>
          <li>The senior quality bar</li>
          <li>Every accept or reject decision</li>
        </ul>
      </div>
      <div class="split-col">
        <p class="d-caps split-head">VOLUME · THE WORKFLOWS</p>
        <ul>
          <li>Multi-agent research and synthesis</li>
          <li>Option generation at speed</li>
          <li>Building the screens in Figma</li>
          <li>Token and component sweeps</li>
          <li>Adversarial QA passes</li>
        </ul>
      </div>
    </div>
    <div class="zig">
      <div class="zig-row">
        <div class="d-cell zig-img">
          <Picture
            src={mockOnboarding}
            widths={[760, 1520]}
            sizes="(max-width: 900px) 100vw, 760px"
            formats={['avif', 'webp']}
            alt="Onboarding's payoff staged in a browser: the number one revenue leak found, stated in dollars"
            loading="lazy"
          />
        </div>
        <div class="zig-cap">
          <p class="d-caps">FIG. 09 · ONBOARDING’S PAYOFF</p>
          <p>
            In 38 seconds, reading data the customer already had: the number one leak, in
            dollars, with the fix one click away. No new SDK, and nothing to configure first.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- STATED FLAT (honesty text never animates) -->
  <section class="fl-limit container cv-auto">
    <div class="fl-limit-card">
      <p class="d-caps fl-limit-label">STATED FLAT</p>
      <p class="tnum">
        Speed was never the hard part, and this case proves nothing about whether anyone wants the
        product. Roughly 8.5 screens a day is a real number, every number inside the screens is
        invented, and stays labelled that way.
      </p>
    </div>
  </section>

  <SandwichClose
    slug="flowlift"
    stagedBrowser={true}
    phoneFill={true}
    browserScreen={mockHero}
    browserAlt="The FlowLift dashboard staged in a browser"
    phoneScreen={mockPhoneA}
    phoneAlt="The dashboard on a phone, staged"
    cell1={mockPhoneB}
    cell1Alt="Adding a data source on mobile, staged"
    cell2={mockZigB}
    cell2Alt="The leak detail staged in a browser"
    signoffCaps="SEVEN DAYS · NO USERS, SAID TWICE"
    chips={['~60 SCREENS · 4 PLATFORMS', 'SYSTEM BEFORE SCREENS', 'NO USERS · INVENTED DATA']}
    nextClaim="BLUFF. Fifteen months on a real casino’s money flows."
  />

  <script src="../../scripts/stat-motion.ts"></script>
</Base>

<style>
  /* ---- hero ---- */
  .fl-h1 {
    margin-top: 28px;
    font-size: clamp(2.0625rem, 5.3vw, 4.75rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.07;
    color: var(--ink);
  }
  .fl-h1 em {
    font-style: normal;
    color: var(--accent);
  }

  .fl-disclosure {
    margin-top: 36px;
    max-width: 900px;
    background: var(--accent-tint);
    border-radius: var(--r-card);
    padding: 28px 32px;
  }
  .fl-disclosure-label {
    color: var(--accent);
    margin-bottom: 10px;
  }
  .fl-disclosure p:last-child {
    max-width: 836px;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--ink);
  }

  .fl-kv {
    margin: 40px 0 0;
    display: flex;
    gap: 64px;
    flex-wrap: wrap;
  }
  .fl-kv div {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 220px;
  }
  .fl-kv dd {
    margin: 0;
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink);
  }
  .fl-receipts {
    margin-top: 28px;
    font-size: var(--fs-caps);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
    line-height: var(--lh-caps);
    font-feature-settings: 'case' 1;
    color: var(--accent);
  }

  .day-rail {
    margin-top: 28px;
    display: flex;
    align-items: center;
    gap: 24px;
    max-width: 900px;
  }
  .rail-day {
    color: var(--ink);
  }
  .rail-dots {
    flex: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .rail-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border);
  }
  .rail-dot-end {
    background: var(--accent);
  }

  .fl-hero-exh {
    padding-top: 40px;
    padding-bottom: 64px;
  }

  /* ---- LOG dividers ---- */
  .log {
    margin-top: 80px;
    border-top: 1px solid var(--border);
    padding-top: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 40px;
  }
  .log-left {
    display: flex;
    align-items: baseline;
    gap: 20px;
  }
  .log-num {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
    font-feature-settings: 'case' 1;
    color: var(--accent);
  }
  .log-name {
    font-size: 2.25rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .log-ghost {
    font-size: clamp(96px, 11vw, 160px);
    font-weight: 500;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 2px color-mix(in srgb, var(--accent) 22%, transparent);
    user-select: none;
  }

  /* ---- bodies ---- */
  .fl-body {
    padding-top: 40px;
  }
  .fl-wide {
    margin-top: 48px;
  }

  .fl-bento-2 {
    margin-top: 48px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .fl-scene {
    margin-top: 48px;
  }
  .fl-scene :global(img) {
    width: 100%;
    height: auto;
  }

  /* ---- the week's workflow, drawn in code so it reflows on mobile ---- */
  .wf-board {
    background: #101210;
    border-radius: var(--r-cell);
    padding: clamp(28px, 4vw, 56px) clamp(20px, 3vw, 44px);
  }
  .wf-track {
    border: 1px solid #262a20;
    border-radius: 16px;
    padding: clamp(20px, 3vw, 40px) clamp(16px, 2vw, 28px);
    display: flex;
    align-items: stretch;
    gap: 12px;
  }
  .wf-stage {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    text-align: center;
    border: 1px solid #33372c;
    border-radius: 12px;
    padding: 18px 12px;
  }
  .wf-stage-t {
    font-size: 0.9375rem;
    font-weight: 600;
    color: #f2f2ef;
    letter-spacing: -0.01em;
  }
  .wf-stage-s {
    font-size: 0.78125rem;
    line-height: 1.45;
    color: #8b8e85;
  }
  .wf-gate {
    border-color: #a0f554;
    background: rgba(160, 245, 84, 0.05);
    box-shadow: 0 0 28px rgba(160, 245, 84, 0.16);
  }
  .wf-gate .wf-stage-s {
    color: #a0f554;
  }
  .wf-arrow {
    align-self: center;
    flex: 0 0 auto;
    display: flex;
    color: #69b12a;
  }

  /* the full marketing page inside a fixed window — scroll to read it all */
  .fl-landing-scroll {
    margin-top: 48px;
    max-height: 760px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .fl-landing-scroll :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .fl-landing-scroll:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .zig {
    margin-top: 48px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .zig-row {
    display: flex;
    align-items: center;
    gap: 48px;
  }
  .zig-row-flip {
    flex-direction: row-reverse;
  }
  .zig-img {
    flex: 0 0 63%;
  }
  .zig-img :global(img) {
    width: 100%;
    height: auto;
  }
  .zig-cap {
    max-width: 392px;
  }
  .zig-cap p:last-child {
    margin-top: 12px;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink-secondary);
  }


  /* ---- split table (machine layer stays commodity-quiet) ---- */
  .split-table {
    margin-top: 48px;
    display: grid;
    grid-template-columns: 1fr 1fr;
