---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ArtefactButtons from '../../components/ArtefactButtons.astro';
import SandwichClose from '../../components/SandwichClose.astro';
import { cases } from '../../data/cases';
import '../../styles/dossier.css';

// His mockup board (Figma canvas 468:2427) — numbered frames, mapped to
// slots per his placeholder drafts in the case frame. 16 and 18 are
// byte-identical duplicates of 15 and stay unused.
import kvMain from '../../assets/paymentx/new/mock-01.png';
import kvProfile from '../../assets/paymentx/new/mock-02.png';
import kvRental from '../../assets/paymentx/new/mock-03.png';
import kvOffer from '../../assets/paymentx/new/mock-04.png';
import modelLanes from '../../assets/paymentx/new/mock-05-lanes.png';
import modelProvider from '../../assets/paymentx/new/mock-06.png';
import modelWebsite from '../../assets/paymentx/new/mock-07.png';
import m4Merchant from '../../assets/paymentx/new/mock-08.png';
import m4Provider from '../../assets/paymentx/new/mock-09.png';
import m5Transactions from '../../assets/paymentx/new/mock-10.png';
import m5Directory from '../../assets/paymentx/new/mock-11.png';
import chaAccounts from '../../assets/paymentx/new/mock-12.png';
import chaPhone from '../../assets/paymentx/new/mock-13-phone.png';
import chbGateway from '../../assets/paymentx/new/mock-14.png';
import chbStats from '../../assets/paymentx/new/mock-15.png';
import chcLanding from '../../assets/paymentx/new/mock-17-tall.png';
import chdPhone1 from '../../assets/paymentx/new/mock-19-phone.png';
import chdPhone2 from '../../assets/paymentx/new/mock-20-phone.png';
import chdPhone3 from '../../assets/paymentx/new/mock-21-phone.png';
import closeDark from '../../assets/paymentx/new/mock-22.png';
import closePhone from '../../assets/paymentx/new/mock-23-phone.png';
import closeCell1 from '../../assets/paymentx/new/mock-24.png';
import closeCell2 from '../../assets/paymentx/new/mock-25.png';

const c = cases.paymentx;

const matrix = {
  cols: ['PAYMENT PROCESSORS', 'FREELANCE MARKETPLACES', 'BANKING APPS', 'PAYMENTX'],
  rows: [
    { label: 'Merchants accept payments', cells: [true, false, false, true] },
    { label: 'Providers get hired like freelancers', cells: [false, true, false, true] },
    { label: 'Providers compete for the work', cells: [false, true, false, true] },
    { label: 'All of it in one product', cells: [false, false, false, true] },
  ],
};
---

<Base title={c.metaTitle} description={c.metaDescription} caseTheme="paymentx" ogImage="/og/paymentx.png">
  <!-- hero -->
  <section class="d-hero container">
    <p class="d-chip">(CASE 04 · PAYMENTS MARKETPLACE)</p>
    <h1 class="d-h1">A payments marketplace designed <em>from zero.</em></h1>
    <p class="d-intro">
      PaymentX connects merchants who need payment providers with providers competing for that
      business. There was no product to copy, no research corpus and no second designer.
      <strong
        >I designed the architecture, both sides and the design system, and every screen on this
        page is the real product</strong
      >.
    </p>
    <div class="d-hero-artefacts">
      <ArtefactButtons slug="paymentx" />
    </div>
  </section>

  <!-- key visual bento -->
  <section class="kv container" aria-label="Key visual">
    <div class="kv-grid">
      <div class="kv-main d-cell exhibit" style="view-transition-name: cover-paymentx">
        <Picture
          src={kvMain}
          widths={[792, 1584, 2400]}
          sizes="(max-width: 900px) 100vw, 792px"
          formats={['avif', 'webp']}
          alt="The merchant's website room: revenue, providers and payment performance for one site"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="kv-cell d-cell exhibit">
        <Picture
          src={kvProfile}
          widths={[384, 768]}
          sizes="(max-width: 900px) 100vw, 384px"
          formats={['avif', 'webp']}
          alt="A provider profile: gateways, potential offers and contact details"
          loading="eager"
        />
      </div>
      <div class="kv-stat" role="img" aria-label="Checkout drop: 14% before, 0 after the inline refund call">
        <p class="d-caps">CHECKOUT DROP</p>
        <p class="kv-stat-line tnum">14% → 0</p>
        <p class="d-caps">AFTER THE INLINE REFUND CALL</p>
      </div>
      <div class="kv-cell d-cell exhibit">
        <Picture
          src={kvRental}
          widths={[384, 768]}
          sizes="(max-width: 900px) 100vw, 384px"
          formats={['avif', 'webp']}
          alt="A rental in detail: the provider's performance on one website"
          loading="lazy"
        />
      </div>
      <div class="kv-cell d-cell exhibit">
        <Picture
          src={kvOffer}
          widths={[384, 768]}
          sizes="(max-width: 900px) 100vw, 384px"
          formats={['avif', 'webp']}
          alt="The Send Rental Offer modal, with the merchant verified by public key"
          loading="lazy"
        />
      </div>
      <div class="kv-fact">
        <p class="kv-fact-num tnum" data-countup aria-live="polite">2,392</p>
        <p class="kv-fact-caps">PROVIDERS IN THE DIRECTORY</p>
      </div>
    </div>
  </section>

  <!-- metadata strip -->
  <section class="container">
    <dl class="d-meta">
      <div class="d-meta-kv">
        <dt class="d-caps">ROLE</dt>
        <dd>Sole product designer</dd>
      </div>
      <div class="d-meta-kv">
        <dt class="d-caps">SCOPE</dt>
        <dd>Architecture, both sides, design system</dd>
      </div>
      <div class="d-meta-outcomes">
        <p class="d-caps">OUTCOMES</p>
        <ul>
          <li>Architecture from zero, no references</li>
          <li>Two sides running one component system</li>
          <li class="tnum">Checkout drop 14% → 0 after the inline refund call</li>
        </ul>
      </div>
    </dl>
  </section>

  <!-- M1 · the moment -->
  <section class="mol container cv-auto">
    <div class="m-head">
      <h2 class="m-claim">No references existed. That was the brief.</h2>
      <span class="m-num" aria-hidden="true">01</span>
    </div>
    <p class="m-para">
      A client arrived over Discord with a marketplace idea: merchants hiring payment providers
      the way you would hire a freelancer. Nothing comparable existed to steal patterns from, and
      both sides needed opposite things from the same product. The usual starting points,
      competitor teardowns and pattern libraries, were <strong>worth nothing here</strong>.
    </p>
    <div class="matrix">
      <div class="matrix-scroll">
        <table>
          <thead>
            <tr>
              <td></td>
              {matrix.cols.map((col, i) => <th class:list={['d-caps', { 'col-px': i === 3 }]} scope="col">{col}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              matrix.rows.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  {row.cells.map((on, i) =>
                    i === 3 ? (
                      <td class="cell-px">
                        <span class="pill-dot">
                          <span class="dot dot-accent" aria-hidden="true" />
                          <span class="sr-only">yes</span>
                        </span>
                      </td>
                    ) : (
                      <td>
                        {on ? (
                          <>
                            <span class="dot dot-ink" aria-hidden="true" />
                            <span class="sr-only">yes</span>
                          </>
                        ) : (
                          <span class="dash">—</span>
                        )}
                      </td>
                    )
                  )}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
    <p class="fig-caption">FIG. 02 · CATEGORY MAP, NOT A FEATURE AUDIT · NOTHING COMBINED ALL FOUR</p>
  </section>

  <!-- M2 · the constraint -->
  <section class="mol container cv-auto">
    <div class="m-head">
      <h2 class="m-claim">Two sides, opposed incentives, one designer.</h2>
      <span class="m-num" aria-hidden="true">02</span>
    </div>
    <p class="m-para">
      Merchants want leverage over providers, providers want qualified merchants without a race to
      the bottom, and the product had to serve both without a sales team translating. Add no
      research budget and a client who communicated in bursts, and
      <strong>every architectural mistake would be mine to find</strong>.
    </p>
    <div class="inc-scrub" data-scrub>
      <div class="inc-stage">
        <div class="inc-map">
          <div class="inc-side inc-side-m" tabindex="0">
            <div class="side-head">
              <span class="side-icon"><Icon name="storefront" size={22} /></span>
              <span class="side-id">
                <span class="caps-xs">DEMAND SIDE</span>
                <span class="side-name">Merchants</span>
              </span>
            </div>
            <div class="side-div" aria-hidden="true"></div>
            <p class="caps-xs">WHAT THEY WANT</p>
            <ul class="side-wants">
              <li><Icon name="scales" size={16} class="want-icon" /> Leverage over providers</li>
              <li><Icon name="trend-down" size={16} class="want-icon" /> Lower fees, faster settlement</li>
            </ul>
          </div>

          <div class="inc-flows inc-flows-m" aria-hidden="true">
            <div class="flow">
              <span class="flow-pill caps-xs">HIRE THROUGH</span>
              <span class="flow-line flow-to-r"></span>
            </div>
            <div class="flow">
              <span class="flow-pill caps-xs">PAY INTO</span>
              <span class="flow-line flow-to-r"></span>
            </div>
          </div>

          <div class="inc-centre">
            <span class="ring ring-outer" aria-hidden="true"></span>
            <span class="ring ring-inner" aria-hidden="true"></span>
            <div class="inc-core">
              <p class="inc-core-title">ONE PRODUCT</p>
              <p class="inc-core-sub">one component grammar</p>
            </div>
          </div>

          <div class="inc-flows inc-flows-p" aria-hidden="true">
            <div class="flow">
              <span class="flow-pill caps-xs">COMPETE THROUGH</span>
              <span class="flow-line flow-to-l"></span>
            </div>
            <div class="flow">
              <span class="flow-pill caps-xs">GET PAID FROM</span>
              <span class="flow-line flow-to-r"></span>
            </div>
          </div>

          <div class="inc-side inc-side-p" tabindex="0">
            <div class="side-head">
              <span class="side-icon"><Icon name="bank" size={22} /></span>
              <span class="side-id">
                <span class="caps-xs">SUPPLY SIDE</span>
                <span class="side-name">Providers</span>
              </span>
            </div>
            <div class="side-div" aria-hidden="true"></div>
            <p class="caps-xs">WHAT THEY WANT</p>
            <ul class="side-wants">
              <li><Icon name="seal-check" size={16} class="want-icon" /> Qualified merchants</li>
              <li><Icon name="shield-check" size={16} class="want-icon" /> No race to the bottom</li>
            </ul>
          </div>
        </div>
        <p class="fig-caption">FIG. 03 · TWO SIDES, OPPOSED WANTS, ONE GRAMMAR BETWEEN THEM</p>
      </div>
      <div class="inc-steps">
        <div class="inc-step" data-step="merchants">
          <p class="d-caps">01 · MERCHANTS</p>
          <p>Merchants want leverage over providers, lower fees, faster settlement.</p>
        </div>
        <div class="inc-step" data-step="providers">
          <p class="d-caps">02 · PROVIDERS</p>
          <p>Providers want qualified merchants, without a race to the bottom.</p>
        </div>
        <div class="inc-step" data-step="one">
          <p class="d-caps">03 · ONE PRODUCT</p>
          <p>Two sides, opposed wants, one grammar between them.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- M3 · the decision (inset room) -->
  <div class="d-inset-wrap cv-auto">
    <section class="d-inset" data-reach="case_proof_reach" data-case="paymentx">
      <div class="m-head">
        <h2 class="m-claim">Architecture before pixels. Weeks of it.</h2>
        <span class="m-num" aria-hidden="true">03</span>
      </div>
      <p class="m-para m-para-strong">
        I mapped both sides’ jobs, money flows and failure states before opening a single screen
        file, because with two user types sharing one system, a wrong object model would poison
        every screen after it. I fixed what a provider is, what a website is and where money
        changes hands, and I drew every screen out of that model.
      </p>

      <!-- FIG 04 · the object model -->
      <figure class="om-card">
        <div class="om-scroll">
          <div class="om-chain">
            <div class="om-node">
              <p class="caps-xs">SUPPLY SIDE</p>
              <p class="om-name">Provider</p>
              <p class="om-desc">Owns processing capacity<br />Sets limits, fees, payout terms</p>
            </div>
            <div class="om-link" aria-hidden="true">
              <span class="caps-xs">LISTS</span>
              <span class="flow-line flow-to-r"></span>
            </div>
            <div class="om-node om-node-asset">
              <p class="caps-xs om-accent">THE ASSET</p>
              <p class="om-name">Gateway account</p>
              <p class="om-desc">Stripe · PayPal · Adyen<br />Monthly limit, fee %, payout schedule</p>
            </div>
            <div class="om-link" aria-hidden="true">
              <span class="caps-xs">RENTS</span>
              <span class="flow-line flow-to-r"></span>
              <span class="om-link-sub">terms locked</span>
            </div>
            <div class="om-node">
              <p class="caps-xs">DEMAND SIDE</p>
              <p class="om-name">Merchant</p>
              <p class="om-desc">Needs capacity to<br />process payments</p>
            </div>
            <div class="om-link" aria-hidden="true">
              <span class="caps-xs">ALLOCATES</span>
              <span class="flow-line flow-to-r"></span>
            </div>
            <div class="om-node">
              <p class="caps-xs">WHERE MONEY FLOWS</p>
              <p class="om-name">Website</p>
              <p class="om-desc">Per-account spend cap<br />Live spend vs cap</p>
            </div>
          </div>
        </div>
        <div class="om-ledger">
          <span class="caps-xs">EVERY MOVE RECORDED</span>
          <span class="om-ledger-name">Transaction ledger</span>
          <span class="om-ledger-desc">status · fee · card mask · destination, filterable across every account and site</span>
        </div>
        <figcaption class="om-caption">
          Four objects, one chain: providers list gateway accounts, merchants rent them on locked
          terms and allocate them to websites under hard caps. Once this model existed, the
          navigation, detail pages and tables fell out of it instead of being invented one by one.
        </figcaption>
      </figure>

      <!-- FIG 05 · the token tiers -->
      <figure class="om-card">
        <div class="om-scroll">
          <div class="om-chain om-chain-tiers">
            <div class="om-node">
              <p class="caps-xs">TIER 1 · 55 TOKENS</p>
              <p class="om-name">Primitive ramps</p>
              <p class="om-desc">
                Raw values, no meaning yet. Neutral 0–950 plus Blue, Green, Red, Rose, Orange,
                Gold, Slate ramps.
              </p>
              <span class="tk-chip">Blue/500</span>
            </div>
            <div class="om-link" aria-hidden="true">
              <span class="caps-xs">FEEDS</span>
              <span class="flow-line flow-to-r"></span>
            </div>
            <div class="om-node">
              <p class="caps-xs">TIER 2 · 31 × 2 MODES</p>
              <p class="om-name">Semantic tokens</p>
              <p class="om-desc">
                Meaning, per theme. Each token resolves differently in Light and Dark: bg/canvas,
                text/primary, brand/default…
              </p>
              <span class="tk-chip">brand/default</span>
            </div>
            <div class="om-link" aria-hidden="true">
              <span class="caps-xs">FEEDS</span>
              <span class="flow-line flow-to-r"></span>
            </div>
            <div class="om-node">
              <p class="caps-xs">TIER 3 · 70 TOKENS</p>
              <p class="om-name">Component tokens</p>
              <p class="om-desc">
                One per decision a component makes, aliased to semantics. Buttons, inputs and
                tables never touch a raw hex.
              </p>
              <span class="tk-chip tk-chip-solid">Button/Primary/bg</span>
            </div>
          </div>
        </div>
        <div class="om-ledger">
          <span class="caps-xs">ONE REAL CHAIN</span>
          <span class="tk-chain tnum">
            <span class="tk-chip">Blue/500</span>
            <span class="tk-arrow" aria-hidden="true">→</span>
            <span class="tk-chip">brand/default</span>
            <span class="tk-arrow" aria-hidden="true">→</span>
            <span class="tk-chip tk-chip-solid">Button/Primary/bg</span>
          </span>
          <span class="om-ledger-desc">flip the mode, everything follows</span>
        </div>
        <figcaption class="om-caption">
          Three tiers, so one change to a primitive ramp ripples through both themes and every
          component without anyone re-picking a hex.
        </figcaption>
      </figure>

      <div class="m3-rendered">
        <p class="d-caps">THE MODEL, RENDERED</p>
        <div class="m3-cells">
          <div class="d-cell exhibit">
            <Picture
              src={modelLanes}
              widths={[420, 840]}
              sizes="(max-width: 900px) 100vw, 320px"
              formats={['avif', 'webp']}
              alt="The screen map that fell out of the model: public site, merchant app, provider app, system overlays"
              loading="lazy"
            />
          </div>
          <div class="d-cell exhibit">
            <Picture
              src={modelProvider}
              widths={[420, 840]}
              sizes="(max-width: 900px) 100vw, 320px"
              formats={['avif', 'webp']}
              alt="The provider object, rendered: profile with reviews"
              loading="lazy"
            />
          </div>
          <div class="d-cell exhibit">
            <Picture
              src={modelWebsite}
              widths={[420, 840]}
              sizes="(max-width: 900px) 100vw, 320px"
              formats={['avif', 'webp']}
              alt="The website object, rendered: add a website, point its DNS"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- M4 · the thrown-away -->
  <section class="mol container cv-auto">
    <div class="m-head">
      <h2 class="m-claim">The obvious split got killed.</h2>
      <span class="m-num" aria-hidden="true">04</span>
    </div>
    <p class="m-para">
      The obvious build was two separate apps, one per side, and every adjacent marketplace seemed
      to validate it. <strong>I killed it.</strong> It doubles every future feature, and trust
      earned on one side never transfers to the other. I ran both sides on one component grammar
      instead, so a merchant reading a provider profile sees the same language the provider wrote
      it in.
    </p>
    <div class="m4-pair">
      <figure>
        <div class="d-cell exhibit">
          <Picture
            src={m4Merchant}
            widths={[584, 1168]}
            sizes="(max-width: 900px) 100vw, 584px"
            formats={['avif', 'webp']}
            alt="The merchant's My Rentals: the same relationship, seen from the demand side"
            loading="lazy"
          />
        </div>
        <figcaption class="fig-caption">FIG. 06 · MERCHANT SIDE, SAME GRAMMAR</figcaption>
      </figure>
      <figure>
        <div class="d-cell exhibit">
          <Picture
            src={m4Provider}
            widths={[584, 1168]}
            sizes="(max-width: 900px) 100vw, 584px"
            formats={['avif', 'webp']}
            alt="The provider's My Rentals: the same relationship, seen from the supply side"
            loading="lazy"
          />
        </div>
        <figcaption class="fig-caption">FIG. 07 · PROVIDER SIDE, SAME GRAMMAR</figcaption>
      </figure>
    </div>
  </section>

  <!-- M5 · the result (tint band) -->
  <section class="m5 cv-auto">
    <div class="container">
      <div class="m-head">
        <h2 class="m-claim">Refunds moved inline. The drop disappeared.</h2>
        <span class="m-num" aria-hidden="true">05</span>
      </div>
      <p class="m-para">
        My sharpest single call in the system: a refund behind a modal read as a dead end at the
        exact moment trust decides, so
        <strong>I moved refunds inline into the checkout flow and the 14% checkout drop went to zero</strong
        >. I made the directory argue the same way, ratings, limits and processor badges first,
        2,392 providers listed, price last.
      </p>
      <div class="m5-visuals">
        <figure>
          <div class="d-cell exhibit m5-img">
            <Picture
              src={m5Transactions}
              widths={[460, 920, 1600]}
              sizes="(max-width: 900px) 100vw, 460px"
              formats={['avif', 'webp']}
              alt="The transaction ledger where every refund lives in flow: accepted and declined, filterable"
              loading="lazy"
            />
          </div>
          <figcaption class="fig-caption">FIG. 08 · THE INLINE REFUND, IN FLOW</figcaption>
        </figure>
        <figure>
          <div class="d-cell exhibit m5-img">
            <Picture
              src={m5Directory}
              widths={[460, 920, 1600]}
              sizes="(max-width: 900px) 100vw, 460px"
              formats={['avif', 'webp']}
              alt="The provider directory: ratings, limits and processor badges first, price last"
              loading="lazy"
            />
          </div>
          <figcaption class="fig-caption">FIG. 09 · THE DIRECTORY, TRUST FIRST</figcaption>
        </figure>
        <div class="m5-stats">
          <div class="m5-stat">
            <p class="d-stat-value">14% → 0</p>
            <p class="d-caps">CHECKOUT DROP, AFTER THE CALL</p>
          </div>
          <div class="m5-stat">
            <p class="d-stat-value" data-countup aria-live="polite">2,392</p>
            <p class="d-caps">PROVIDERS IN THE DIRECTORY</p>
          </div>
          <div class="m5-bars" role="img" aria-label="Before: refund in a modal, 14% of checkouts dropped. After: refund inline, 0 measured.">
            <div class="m5-bar">
              <p class="caps-xs">BEFORE · REFUND IN A MODAL</p>
              <div class="m5-track"><span class="m5-fill" style="width: 14%" data-fill="14%"></span></div>
              <p class="m5-bar-sub tnum">14% of checkouts dropped</p>
            </div>
            <div class="m5-bar">
              <p class="caps-xs">AFTER · REFUND INLINE</p>
              <div class="m5-track"></div>
              <p class="m5-bar-sub m5-bar-zero tnum">0 measured</p>
            </div>
          </div>
        </div>
      </div>
      <div class="m5-artefacts">
        <ArtefactButtons slug="paymentx" />
      </div>
    </div>
  </section>

  <!-- CH A · the merchant side -->
  <section class="chap container cv-auto">
    <div class="ch-head">
      <p class="ch-label">THE MERCHANT SIDE · A</p>
      <span class="m-num" aria-hidden="true">07</span>
    </div>
    <p class="ch-caption">
      I gave merchants one room for everything they rent: the provider directory, their websites,
      spend and limits per gateway.
    </p>
    <div class="cha-bento">
      <div class="d-cell exhibit cha-browser">
        <Picture
          src={chaAccounts}
          widths={[792, 1584, 2400]}
          sizes="(max-width: 900px) 100vw, 792px"
          formats={['avif', 'webp']}
          alt="The merchant's providers and accounts room: 43 accounts, spend and limits per gateway, one toggle each"
          loading="lazy"
        />
      </div>
      <div class="d-cell exhibit cha-phone">
        <Picture
          src={chaPhone}
          widths={[384, 768]}
          sizes="(max-width: 900px) 100vw, 384px"
          formats={['avif', 'webp']}
          alt="The same website room at 390 wide"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- CH B · the provider side (zigzag) -->
  <section class="chap container cv-auto">
    <div class="ch-head">
      <p class="ch-label">THE PROVIDER SIDE · B</p>
      <span class="m-num" aria-hidden="true">08</span>
    </div>
    <p class="ch-caption">
