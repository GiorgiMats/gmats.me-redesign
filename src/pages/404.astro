---
import Base from '../layouts/Base.astro';

const title = 'Page not found · Giorgi Matsukatovi';
const description =
  'This page was never designed. Nobody made a call here, which is exactly how a page ends up like this.';
---

<Base title={title} description={description}>
  <section class="nf">
    <p class="nf-ghost tnum" aria-hidden="true">404</p>
    <div class="nf-body container">
      <h1>This page was <em>never designed.</em></h1>
      <p class="nf-sub">
        Nobody made a call here, which is exactly how a page ends up like this. The rest of the
        site got more attention.
      </p>
      <a href="/" class="pill pill-solid nf-cta">Back to the designed part</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    position: relative;
    overflow: hidden;
    min-height: 760px;
    display: flex;
    align-items: center;
  }

  .nf-ghost {
    position: absolute;
    top: 20px;
    left: 61vw;
    font-size: clamp(180px, 29vw, 420px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.3;
    color: rgba(26, 27, 30, 0.05);
    white-space: nowrap;
    user-select: none;
  }

  .nf-body {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .nf h1 {
    font-size: clamp(2.0625rem, 3.9vw, 3.5rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .nf em {
    font-style: normal;
    color: var(--accent);
  }

  .nf-sub {
    margin-top: 24px;
    max-width: 560px;
    font-size: 1.1875rem;
    line-height: 1.6;
    color: var(--ink-secondary);
  }

  .nf-cta {
    margin-top: 56px;
    padding: 16px 28px;
    font-size: 1rem;
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .nf {
      min-height: 560px;
    }
    .nf-ghost {
      left: 40vw;
      top: 40px;
    }
    .nf-cta {
      margin-top: 36px;
    }
  }
</style>
