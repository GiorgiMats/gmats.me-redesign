---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import WorkGrid from '../components/WorkGrid.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import { SITE } from '../data/site';

import baBefore from '../assets/home/ba-before.png';
import baAfter from '../assets/home/ba-after.png';
import portrait from '../assets/home/portrait.png';
import offerStep2 from '../assets/home/offer-step2-slider.png';
import offerStep3 from '../assets/home/offer-step3-thumb.png';
import thesisImproved from '../assets/home/thesis-improved-site.png';
import thesisBraces from '../assets/home/thesis-braces.png';

const title = 'Giorgi Matsukatovi · Senior Product Designer';
const description =
  'I design the screens that make people trust your AI product: the error states, the money flows, the moments that read generated today. Shipped as working product you can check.';
---

<Base title={title} description={description}>
  <!-- ============ HERO ============ -->
  <section class="hero container">
    <div class="hero-meta caps-sm">
      <p class="tnum">{SITE.coordinates} · TBILISI / REMOTE</p>
      <p>GIORGI MATSUKATOVI · SENIOR PRODUCT DESIGNER · 6+ YEARS</p>
    </div>
    <h1 class="hero-h1">
      <span class="only-desktop">Your AI product works.<br />It doesn’t <em>look</em> like it yet.</span>
      <span class="only-mobile">Your AI product works.<br />It doesn’t <em>look</em><br />like it yet.</span>
    </h1>
    <div class="hero-row">
      <p class="hero-sub">
        A senior designer with six years of shipped products, hands on yours. I design the screens
        that make people trust it, shipped as working product you can check.
      </p>
      <div class="hero-ctas">
        <a
          href={`mailto:${SITE.email}`}
          class="pill pill-solid hero-email"
          data-event="outbound_click"
          data-channel="email"
          data-cta="true"
        >
          Email me
          <Icon name="arrow-up-right" size={16} />
        </a>
        <a
          href={SITE.linkedin}
          target="_blank"
          rel="noopener"
          class="hero-dm"
          data-event="outbound_click"
          data-channel="linkedin"
          data-cta="true"
        >
          DM on LinkedIn
          <Icon name="arrow-up-right" size={16} />
        </a>
      </div>
    </div>
  </section>

  <!-- ============ EXHIBIT BAND ============ -->
  <section class="band container" aria-label="PaymentX product exhibit, before and after">
    <figure class="band-exhibit">
      <BeforeAfter
        before={baBefore}
        beforeAlt="The PaymentX landing page as an AI build ships it: generic hero, grey blocks, no voice"
        after={baAfter}
        afterAlt="The PaymentX landing page as designed: the real hero, staged in a browser"
        aspect="4 / 3"
        start={30}
      />
      <figcaption class="band-label caps-sm">PAYMENTX · FIG. 01 · THE PUBLIC LANDING</figcaption>
      <p class="band-basis caps-sm" aria-hidden="true">REAL PRODUCT SCREENS · NOT MOCKUPS</p>
      <div class="band-stat" role="img" aria-label="Checkout drop: 14% before, 0 after the inline call">
        <p class="caps-sm stat-label">CHECKOUT DROP</p>
        <p class="stat-line tnum">
          <span>14%</span>
          <Icon name="arrow-right" size={22} class="stat-arrow" />
          <span class="stat-zero">0</span>
        </p>
        <p class="caps-xs stat-basis">AFTER THE INLINE CALL</p>
      </div>
      <p class="band-chip caps-sm">
        <Icon name="git-pull-request" size={16} />
        FIX #3 APPROVED
      </p>
    </figure>
  </section>

  <!-- ============ JUDGMENT ============ -->
  <section class="judgment-wrap" data-reach="home_beat_reach" data-beat="judgment">
    <div class="judgment">
      <p class="chip caps-sm">(THE PART YOU HIRE)</p>
      <h2 class="judgment-statement">
        <span class="ghost">Anyone can give prompts to AI.</span><br />I’ll make your product
        convert.
      </h2>
      <div class="judgment-cols">
        <div class="portrait-col">
          <div class="portrait exhibit">
            <Picture
              src={portrait}
              widths={[380, 760]}
              sizes="(max-width: 900px) 100vw, 380px"
              formats={['avif', 'webp']}
              alt="Giorgi Matsukatovi, black and white portrait"
              loading="lazy"
            />
          </div>
          <p class="lockup">
            <span class="caps-sm lockup-name">GIORGI MATSUKATOVI</span>
            <span class="caps-sm lockup-role">SENIOR PRODUCT DESIGNER · 6+ YEARS</span>
          </p>
        </div>
        <div class="judgment-right">
          <p class="judgment-lead">AI gets you to working. The part you hire is the judgment:</p>
          <ul class="calls">
            <li>
              <Icon name="browsers" size={24} class="call-icon" />
              How to stop looking like every other AI-built site
            </li>
            <li>
              <Icon name="user-plus" size={24} class="call-icon" />
              How to win back clients who passed because it felt cheap
            </li>
            <li>
              <Icon name="funnel" size={24} class="call-icon" />
              Why your signup flow loses half its visitors
            </li>
          </ul>
          <p class="judgment-note">The cases below show the calls, marked in blue.</p>
          <a href="/project" class="arrow-link">
            See the calls
            <Icon name="arrow-right" size={16} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SELECTED WORK ============ -->
  <div class="ghost-marker" aria-hidden="true">selected work</div>
  <section class="work cv-auto" data-reach="home_beat_reach" data-beat="work" aria-label="Selected work">
    <WorkGrid />
  </section>

  <!-- ============ THE OFFER (/#offer) ============ -->
  <section class="offer cv-auto" id="offer" data-reach="offer_view">
    <div class="container">
      <p class="chip chip-on-tint caps-sm">(THE OFFER)</p>
      <div class="offer-head">
        <h2 class="offer-h2">Send a link.<br />Get fixes back.</h2>
        <div class="offer-paras">
          <p>
            I direct Claude Code against your product’s code myself, so every fix arrives as a
            change you can review, question and approve.
          </p>
        </div>
      </div>
      <ol class="offer-cards">
        <li>
          <p class="offer-num caps-sm tnum">01</p>
          <h3 class="offer-title">
            <Icon name="link-simple" size={22} class="offer-icon" />
            You send me your site link
          </h3>
          <div class="offer-card">
            <p class="caps-xs offer-card-label">STEP 01</p>
            <div class="dm">
              <div class="dm-row">
                <span class="dm-avatar" aria-hidden="true"></span>
                <div class="dm-bubbles">
                  <p class="dm-bubble">Here’s my site: amazing.com</p>
                  <p class="dm-bubble">Go!</p>
                </div>
              </div>
              <div class="dm-row dm-mine">
                <p class="dm-bubble dm-bubble-accent">On it!</p>
                <span class="dm-avatar dm-avatar-me">
                  <Picture
                    src={portrait}
                    widths={[48, 96]}
                    sizes="24px"
                    formats={['avif', 'webp']}
                    alt=""
                    loading="lazy"
                  />
                </span>
              </div>
            </div>
          </div>
          <p class="offer-desc">That’s the whole onboarding. No workshop, no discovery deck.</p>
        </li>
        <li>
          <p class="offer-num caps-sm tnum">02</p>
          <h3 class="offer-title">
            <Icon name="magnifying-glass" size={22} class="offer-icon" />
            I review and improve it
          </h3>
          <div class="offer-card">
            <p class="caps-xs offer-card-label">STEP 02</p>
            <div class="offer-card-art">
              <Picture
                src={offerStep2}
                widths={[335, 670]}
                sizes="(max-width: 900px) 84vw, 335px"
                formats={['avif', 'webp']}
                alt="A generic wireframe site turning into the designed version, split by a comparison divider"
                loading="lazy"
              />
            </div>
          </div>
          <p class="offer-desc">
            A short list of what looks off and what it costs you, then the fixes themselves.
          </p>
        </li>
        <li>
          <p class="offer-num caps-sm tnum">03</p>
          <h3 class="offer-title">
            <Icon name="git-pull-request" size={22} class="offer-icon" />
            I send fixes for approval
          </h3>
          <div class="offer-card">
            <p class="caps-xs offer-card-label">STEP 03</p>
            <div class="dm">
              <div class="dm-row dm-mine">
                <div class="dm-bubbles dm-bubbles-mine">
                  <span class="dm-thumb">
                    <Picture
                      src={offerStep3}
                      widths={[148, 296, 444]}
                      sizes="148px"
                      formats={['avif', 'webp']}
                      alt="A small screenshot of the fixed site"
                      loading="lazy"
                    />
                  </span>
                  <p class="dm-bubble dm-bubble-accent">Here you go! <span class="dm-link">https://amazing.com/</span></p>
                </div>
                <span class="dm-avatar dm-avatar-me">
                  <Picture
                    src={portrait}
                    widths={[48, 96]}
                    sizes="24px"
                    formats={['avif', 'webp']}
                    alt=""
                    loading="lazy"
                  />
                </span>
              </div>
              <div class="dm-row">
                <span class="dm-avatar" aria-hidden="true"></span>
                <div class="dm-bubbles">
                  <p class="dm-bubble">This is awesome! 🔥</p>
                </div>
              </div>
            </div>
          </div>
          <p class="offer-desc">
            You review, question and approve each one. Stop whenever the value stops.
          </p>
        </li>
      </ol>
      <a href="/rescue" class="arrow-link" data-event="offer_expand">
        The full offer, limits included
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </section>

  <!-- ============ HIRING STRIP ============ -->
  <div class="hiring-wrap">
    <aside class="hiring">
      <Icon name="briefcase" size={20} class="hiring-icon" />
      <p>
        Hiring for a full-time role?
        <a href="/about#availability" data-event="employment_route_click">There’s a page for that too.</a>
      </p>
    </aside>
  </div>

  <!-- ============ TWO OPINIONS ============ -->
  <section class="theses container cv-auto" aria-label="Two opinions">
    <div class="opinion">
      <div class="opinion-art">
        <Picture
          src={thesisImproved}
          widths={[576, 1152]}
          sizes="(max-width: 900px) 100vw, 576px"
          formats={['avif', 'webp']}
          alt="A crowd queues at the booth labelled improved site while the vibe-coded booth stands quiet"
          loading="lazy"
        />
      </div>
      <div class="opinion-rule" aria-hidden="true"></div>
      <Icon name="eye" size={24} />
      <p class="opinion-text">
        Visual quality converts. People decide if your product works by how it looks while working.
      </p>
    </div>
    <div class="opinion">
      <div class="opinion-art">
        <Picture
          src={thesisBraces}
          widths={[576, 1152]}
          sizes="(max-width: 900px) 100vw, 576px"
          formats={['avif', 'webp']}
          alt="A designer holding a paintbrush in one hand and curly braces in the other"
          loading="lazy"
        />
      </div>
      <div class="opinion-rule" aria-hidden="true"></div>
      <Icon name="brackets-curly" size={24} />
      <p class="opinion-text">
        Designers should know code. I came from front-end, and I ship what I draw.
      </p>
    </div>
  </section>

  <!-- ============ CLOSE ============ -->
  <section class="close cv-auto" data-reach="home_beat_reach" data-beat="close">
    <h2 class="close-h2">Let’s get you more clients.</h2>
    <p class="close-sub">
      Send your product over and I’ll tell you which parts read generated, and I’ll stand by every
      call unless you prove me wrong.
    </p>
    <a
      href={`mailto:${SITE.email}`}
      class="circle-cta"
      data-event="outbound_click"
      data-channel="email"
      data-cta="true"
    >
      Email me
      <Icon name="arrow-up-right" size={20} />
    </a>
    <a
      href={SITE.linkedin}
      target="_blank"
      rel="noopener"
      class="close-dm"
      data-event="outbound_click"
      data-channel="linkedin"
      data-cta="true"
    >
      <Icon name="linkedin-logo" size={16} />
      or DM on LinkedIn
    </a>
  </section>

  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Giorgi Matsukatovi',
    jobTitle: 'Senior Product Designer',
    url: SITE.url,
    email: `mailto:${SITE.email}`,
    sameAs: [SITE.linkedin, SITE.dribbble, SITE.x],
  })} />
</Base>

<style>
  /* ---------- shared atoms ---------- */
  .chip {
    display: inline-flex;
    align-items: center;
    padding: 7px 14px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-pill);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
    line-height: var(--lh-caps);
    font-feature-settings: 'case' 1;
    color: var(--ink-secondary);
  }
  .chip-on-tint {
    border-color: var(--border-on-tint);
  }

  .caps-sm,
  .caps-xs {
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
    line-height: var(--lh-caps);
    font-feature-settings: 'case' 1;
  }

  .arrow-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--accent);
  }
  .arrow-link:hover {
    color: var(--accent-bright);
  }

  /* ---------- hero ---------- */
  .hero {
    padding-top: 88px;
    padding-bottom: 40px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .hero-meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: var(--ink-secondary);
  }

  .hero-h1 {
    font-size: clamp(2.0625rem, 6.4vw, 5.75rem); /* 92 at 1440, 33 at 390 */
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.02;
    color: var(--ink);
    text-wrap: initial;
  }
  .hero-h1 em {
    font-style: normal;
    color: var(--cobalt);
  }

  .hero-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
  }

  .hero-sub {
    max-width: 560px;
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--ink-secondary);
  }

  .hero-ctas {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-shrink: 0;
  }

  .hero-email {
    padding: 17px 28px;
    font-size: 1rem;
    font-weight: 600;
  }

  .hero-dm {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
  }
  .hero-dm:hover {
    color: var(--accent);
  }

  /* ---------- exhibit band ---------- */
  .band {
    padding-top: 8px;
    padding-bottom: 72px;
  }

  .band-exhibit {
    position: relative; /* floating stat card + chip overhang the edges */
  }

  .band-label {
    position: absolute;
    z-index: 1;
    top: 30px;
    left: 50%;
    transform: translateX(-50%);
    color: #fff;
    pointer-events: none;
  }
  .band-basis {
    position: absolute;
    z-index: 1;
    bottom: 25px;
    right: 32px;
    color: #fff;
    pointer-events: none;
  }

  .band-stat {
    position: absolute;
    z-index: 1;
    left: 280px;
    bottom: -14px;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: var(--surface);
    border-radius: 14px;
    padding: 16px 20px;
    box-shadow: 0 12px 32px rgba(20, 26, 36, 0.12);
  }
  .stat-label,
  .stat-basis {
    color: var(--ink-secondary);
  }
  .stat-line {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.875rem;
    font-weight: 500;
    line-height: 1.1;
    color: var(--ink);
  }
  .stat-line :global(.stat-arrow) {
    color: var(--cobalt);
  }
  .stat-zero {
    color: var(--cobalt);
  }

  .band-chip {
    position: absolute;
    z-index: 1; /* above the exhibit's hairline overlay */
    top: 16px;
    right: -30px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--ink);
    color: #fff;
    border-radius: var(--r-pill);
    padding: 10px 14px;
  }

  /* ---------- judgment ---------- */
  .judgment-wrap {
    padding: 8px 24px;
  }

  .judgment {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-inset);
    padding: 120px 96px 120px;
    max-width: 1392px;
    margin-inline: auto;
  }

  .judgment-statement {
    margin-top: 48px;
    max-width: 1000px;
    font-size: clamp(1.625rem, 3.75vw, 3.375rem); /* 54 desktop */
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.12;
    color: var(--ink);
  }
  .judgment-statement .ghost {
    color: #b4b9c4;
  }

  .judgment-cols {
    margin-top: 48px;
    display: flex;
    gap: 220px;
    align-items: center;
  }

  .portrait-col {
    flex-shrink: 0;
    width: 380px;
  }
  .portrait {
    border-radius: var(--r-card);
  }
  .portrait :global(img) {
    width: 100%;
    height: auto;
  }
  .lockup {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .lockup-name {
    color: var(--ink);
  }
  .lockup-role {
    color: var(--ink-secondary);
  }

  .judgment-right {
    flex: 1;
    min-width: 0;
  }

  .judgment-lead {
    font-size: 1.0625rem;
    color: var(--ink-secondary);
  }

  .calls {
    list-style: none;
    padding: 0;
    margin-top: 28px;
  }
  .calls li {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 18px 0;
    border-top: 1px solid var(--border);
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--ink);
  }
  .calls :global(.call-icon) {
    color: var(--accent);
    flex-shrink: 0;
  }

  .judgment-note {
    margin-top: 24px;
    font-size: var(--fs-small);
    color: var(--ink-secondary);
  }
  .judgment-right .arrow-link {
    margin-top: 28px;
  }

  /* ---------- selected work ---------- */
  .ghost-marker {
    overflow: hidden;
    height: clamp(100px, 14.6vw, 210px);
    padding-left: clamp(24px, 7.6vw, 110px);
    font-size: clamp(96px, 13.9vw, 200px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.05;
    white-space: nowrap;
    color: rgba(26, 27, 30, 0.05);
    user-select: none;
  }

  .work {
    position: relative;
    padding-bottom: 40px;
  }

  /* ---------- offer ---------- */
  .offer {
    margin-top: 40px;
    background: var(--cobalt-tint);
    padding-top: 140px;
    padding-bottom: 120px;
  }
  .offer .chip {
    background: var(--surface);
  }

  .offer-head {
    margin-top: 40px;
    display: flex;
    justify-content: space-between;
    gap: 48px;
  }

  .offer-h2 {
    font-size: clamp(1.75rem, 3.75vw, 3.375rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.09;
    color: var(--ink);
  }

  .offer-paras {
    width: 560px;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: 1rem;
    line-height: 1.62;
    color: var(--ink-secondary);
  }

  .offer-cards {
    list-style: none;
    padding: 0;
    margin: 64px 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .offer-num {
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--accent);
  }
  .offer-title {
    margin-top: 20px;
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 1.4375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .offer-title :global(.offer-icon) {
    color: var(--ink);
    flex-shrink: 0;
  }

  .offer-card {
    margin-top: 30px;
    background: var(--surface);
    border-radius: 16px;
    padding: 20px 24px 24px;
    min-height: 192px;
  }
  .offer-card-label {
    color: var(--ink-secondary);
  }
  .offer-card-art {
    margin-top: 18px;
  }
  .offer-card-art :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  /* the DM mockups */
  .dm {
    margin-top: 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .dm-row {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }
  .dm-row.dm-mine {
    justify-content: flex-end;
  }
  .dm-avatar {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--sunken);
    overflow: hidden;
  }
  .dm-avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .dm-bubbles {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
  .dm-bubbles-mine {
    align-items: flex-end;
  }
  .dm-bubble {
    background: var(--sunken);
    border-radius: 12px;
    padding: 10px 14px;
    font-size: 0.875rem;
    line-height: 1.35;
    color: var(--ink);
  }
  .dm-bubble-accent {
    background: var(--accent);
    color: #fff;
  }
  .dm-link {
    text-decoration: underline;
  }
  .dm-thumb {
    display: block;
    width: 148px;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 8px 22px rgba(20, 26, 36, 0.14);
  }
  .dm-thumb :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .offer-desc {
    margin-top: 24px;
    font-size: var(--fs-small);
    line-height: 1.6;
