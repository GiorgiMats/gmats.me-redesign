---
import '@fontsource-variable/manrope';
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Case slug — swaps the accent tokens for dossier pages. */
  caseTheme?: 'paymentx' | 'docket' | 'bluff' | 'flowlift';
  /** Absolute path of the OG image (defaults to the site card). */
  ogImage?: string;
  /** Hide chrome (unused today; 404 keeps full chrome). */
  noFooter?: boolean;
}

const { title, description, caseTheme, ogImage = '/og/default.png', noFooter = false } = Astro.props;
const canonical = new URL(Astro.url.pathname === '/index' ? '/' : Astro.url.pathname, SITE.url);
const ogUrl = new URL(ogImage, SITE.url);
---

<!doctype html>
<html lang="en-GB" data-case={caseTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f7f8fa" />
    <link rel="preload" href={manropeLatin} as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="gmats.me" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    {!noFooter && <Footer />}

    <div id="consent" hidden>
      <p class="caps-sm consent-label">ANALYTICS</p>
      <p class="consent-text">
        One cookie-based counter (GA4), so I can tell which pages earn their keep. Nothing else,
        no ads.
      </p>
      <div class="consent-actions">
        <button class="pill pill-solid consent-btn" data-consent="yes">Fine by me</button>
        <button class="pill pill-quiet consent-btn" data-consent="no">No thanks</button>
      </div>
    </div>

    <script src="../scripts/analytics.ts"></script>

    <style>
      .skip-link {
        position: absolute;
        left: 16px;
        top: -48px;
        z-index: 100;
        background: var(--ink);
        color: #fff;
        padding: 10px 18px;
        border-radius: var(--r-pill);
        font-size: var(--fs-small);
        font-weight: 500;
        transition: top 0.15s ease;
      }
      .skip-link:focus-visible {
        top: 12px;
      }

      #consent {
        position: fixed;
        left: 20px;
        bottom: 20px;
        z-index: 90;
        max-width: 320px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--r-card);
        padding: 20px;
        box-shadow: var(--shadow-exhibit);
      }
      .consent-label {
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: var(--track-caps);
        line-height: var(--lh-caps);
        font-feature-settings: 'case' 1;
        color: var(--ink-secondary);
        margin-bottom: 10px;
      }
      .consent-text {
        font-size: var(--fs-small);
        color: var(--ink);
        line-height: 1.5;
        margin-bottom: 14px;
      }
      .consent-actions {
        display: flex;
        gap: 8px;
      }
      .consent-btn {
        font-size: 0.875rem;
        padding: 8px 16px;
      }
      @media (max-width: 900px) {
        #consent {
          left: 12px;
          right: 12px;
          bottom: 12px;
          max-width: none;
        }
      }
    </style>
  </body>
</html>
